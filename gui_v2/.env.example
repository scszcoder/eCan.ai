# ============================================================
# eCan.ai Frontend Environment Configuration
# ============================================================
#
# 新架构：运行时配置（API/WS endpoint、app_id、is_cn、auth_type）由后端
# /api/config 提供，前端不需要构建期硬编码 endpoint。
#
# VITE_* 变量会被 vite 在构建时静态注入到 import.meta.env 中
# 非 VITE_ 前缀的变量不会暴露给前端
#
# 优先级（构建期）：
#   1. .env.local         - 个人覆盖（gitignored）
#   2. .env               - 共享默认（tracked）
#   3. .env.example       - 文档模板（tracked）
#
# 后端真值源：
#   - apps/{cn,intl}/config/auth_config.yml (Cognito/CloudBase)
#   - apps/{cn,intl}/config/cloud_endpoints.json (storage buckets)
#
# ============================================================


# ==================== IPC 模式 ====================
# 强制 IPC 模式（默认桌面端启用 Qt WebChannel，
# 设置为 false 时改用 localWebSocketClient）
# 接受值: true | false | 1 | 0 | yes | no
VITE_IPC_MODE=true


# ==================== CN: 腾讯云 CloudBase（构建期 dev/test 兜底）====================
# 桌面端真值源是 apps/cn/config/auth_config.yml，由后端 /api/config 提供。
# 取消注释并填写以覆盖构建期默认值（仅 Vite dev / 静态 web 部署场景）。
#
# VITE_CLOUDBASE_ENV_ID=your-cloudbase-env-id
# VITE_WECHAT_APP_ID=wx-xxxxxxxxxx


# ==================== Intl: AWS Cognito（构建期 dev/test 兜底）====================
# 桌面端真值源是 apps/intl/config/auth_config.yml，由后端 /api/config 提供。
# 取消注释并填写以覆盖构建期默认值（仅 Vite dev / 静态 web 部署场景）。
#
# VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=your-client-id
# VITE_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:3000/login
# VITE_COGNITO_SCOPES=openid email profile


# ==================== Web 部署: AppSync (Intl Web) ====================
# 仅 Web 部署且走 AppSync 时需要。
# 默认 Intl 桌面端不读这些值（直接走 LocalServer 的 backend 代理）。
#
# VITE_APPSYNC_ENDPOINT=https://xxx.appsync-api.us-east-1.amazonaws.com/graphql
# VITE_APPSYNC_WS_ENDPOINT=wss://xxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql
# VITE_APPSYNC_WS_HOST=xxx.appsync-api.us-east-1.amazonaws.com
# VITE_APPSYNC_API_KEY=da-xxxxxxxxxxxx
#
# Tests 页面专用:
# VITE_APPSYNC_HTTP_ENDPOINT=https://xxx.appsync-api.us-east-1.amazonaws.com/graphql


# ==================== 调试开关 ====================
# 启用 GraphQL 详细日志（api-router）
# VITE_VERBOSE_GRAPHQL=true


# ==================== 测试页面专用 ====================
# VITE_ACCOUNT_OWNER=user@example.com
# VITE_ACCT_SITE_ID=site-xxx
# VITE_A2A_CHANNEL_ID=channel-xxx
# VITE_TASK_RUNNER=runner-xxx