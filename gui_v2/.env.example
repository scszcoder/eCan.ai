# Environment Configuration for Web Deployment
# Copy this file to .env.local and modify as needed

# WebSocket server URL for web deployment mode
# Default: ws://localhost:8765 (local development)
# Production: wss://your-domain.com/ws
VITE_WS_URL=ws://localhost:8765

# Base path for deployment under a subdirectory
# Example: /app/gui-v2/
VITE_BASE=/app/gui-v2/

# AppSync GraphQL endpoint for web API
VITE_APPSYNC_ENDPOINT=

# Deployment mode override (optional)
# Values: desktop, web, auto (default: auto)
# VITE_DEPLOYMENT_MODE=auto

# Cognito Hosted UI (web login)
# Required for web auth
# Example: your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# Example: 1h2k3l4m5n6o7p8q9r0s
VITE_COGNITO_CLIENT_ID=
# Example: https://your-domain.com/app/gui-v2/auth/callback
VITE_COGNITO_REDIRECT_URI=
# Example: https://your-domain.com/app/gui-v2/login
VITE_COGNITO_LOGOUT_URI=
# Space-delimited scopes
VITE_COGNITO_SCOPES=openid email profile
