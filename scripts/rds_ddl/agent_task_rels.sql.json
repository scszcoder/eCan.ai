"CREATE TABLE `agent_task_rels` (\n  `id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `agent_id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `task_id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `vehicle_id` varchar(64) COLLATE utf8mb4_unicode_ci DEFAULT NULL,\n  `status` varchar(32) COLLATE utf8mb4_unicode_ci DEFAULT 'pending',\n  `priority` varchar(32) COLLATE utf8mb4_unicode_ci DEFAULT 'medium',\n  `progress` double DEFAULT '0',\n  `scheduled_start` datetime(6) DEFAULT NULL,\n  `actual_start` datetime(6) DEFAULT NULL,\n  `estimated_end` datetime(6) DEFAULT NULL,\n  `actual_end` datetime(6) DEFAULT NULL,\n  `result` json DEFAULT NULL,\n  `error_message` text COLLATE utf8mb4_unicode_ci,\n  `logs` text COLLATE utf8mb4_unicode_ci,\n  `cpu_usage` double DEFAULT NULL,\n  `memory_usage` double DEFAULT NULL,\n  `execution_time` double DEFAULT NULL,\n  `execution_context` json DEFAULT NULL,\n  `retry_count` int DEFAULT '0',\n  `max_retries` int DEFAULT '3',\n  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),\n  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),\n  PRIMARY KEY (`id`),\n  KEY `fk_atr_agent` (`agent_id`),\n  KEY `fk_atr_task` (`task_id`),\n  KEY `fk_atr_vehicle` (`vehicle_id`),\n  CONSTRAINT `fk_atr_agent` FOREIGN KEY (`agent_id`) REFERENCES `agents` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT,\n  CONSTRAINT `fk_atr_task` FOREIGN KEY (`task_id`) REFERENCES `agent_tasks` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT,\n  CONSTRAINT `fk_atr_vehicle` FOREIGN KEY (`vehicle_id`) REFERENCES `agent_vehicles` (`id`) ON DELETE SET NULL ON UPDATE RESTRICT\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
