"CREATE TABLE `agent_task_skill_rels` (\n  `id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `task_id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `skill_id` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL,\n  `role` varchar(32) COLLATE utf8mb4_unicode_ci DEFAULT 'primary',\n  `execution_order` int DEFAULT '0',\n  `is_required` tinyint(1) DEFAULT '1',\n  `skill_config` json DEFAULT NULL,\n  `parameters` json DEFAULT NULL,\n  `constraints_json` json DEFAULT NULL,\n  `estimated_duration` double DEFAULT NULL,\n  `estimated_cost` double DEFAULT NULL,\n  `resource_requirements` json DEFAULT NULL,\n  `success_criteria` json DEFAULT NULL,\n  `quality_threshold` double DEFAULT '0.8',\n  `status` varchar(32) COLLATE utf8mb4_unicode_ci DEFAULT 'pending',\n  `actual_duration` double DEFAULT NULL,\n  `actual_cost` double DEFAULT NULL,\n  `quality_score` double DEFAULT NULL,\n  `created_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),\n  `updated_at` datetime(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uc_task_skill` (`task_id`,`skill_id`),\n  KEY `fk_ats_skill` (`skill_id`),\n  CONSTRAINT `fk_ats_skill` FOREIGN KEY (`skill_id`) REFERENCES `agent_skills` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT,\n  CONSTRAINT `fk_ats_task` FOREIGN KEY (`task_id`) REFERENCES `agent_tasks` (`id`) ON DELETE CASCADE ON UPDATE RESTRICT\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
