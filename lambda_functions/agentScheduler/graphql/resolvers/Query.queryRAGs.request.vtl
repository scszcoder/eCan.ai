# Invoke Lambda to query RAG chunks (supports filters inside qs)
{
  "version": "2017-02-28",
  "operation": "Invoke",
  "payload": {
    "arguments": {
      "qs": $utils.toJson($context.arguments.qs)
    },
    "identity": {
      "claims": $utils.toJson($context.identity.claims)
    },
    "info": {
      "fieldName": "$context.info.fieldName",
      "parentTypeName": "$context.info.parentTypeName"
    }
  }
}
