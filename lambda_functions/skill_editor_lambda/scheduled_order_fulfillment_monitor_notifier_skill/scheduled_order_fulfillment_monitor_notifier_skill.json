        "data": {
          "title": "code_load_run_config",
          "code": "from datetime import datetime, timezone\n\n# Schedule note: the platform scheduler should trigger this skill daily at 20:00 local time.\n# This node initializes runtime configuration + run context.\n\nstate.setdefault(\"config\", {})\nstate.setdefault(\"run\", {})\n\n# Runtime parameters (edit as needed)\nstate[\"config\"][\"schedule\"] = {\"type\": \"daily\", \"time\": \"20:00\"}\nstate[\"config\"][\"max_orders_per_run\"] = state[\"config\"].get(\"max_orders_per_run\", 50)\nstate[\"config\"][\"include_statuses\"] = state[\"config\"].get(\"include_statuses\", [\"AWAITING_SHIPMENT\"])  # eBay-like\nstate[\"config\"][\"do_label_creation\"] = state[\"config\"].get(\"do_label_creation\", True)\nstate[\"config\"][\"do_mark_shipped\"] = state[\"config\"].get(\"do_mark_shipped\", True)\nstate[\"config\"][\"email_recipients\"] = state[\"config\"].get(\"email_recipients\", [\"ops@example.com\", \"owner@example.com\"])\nstate[\"config\"][\"email_from\"] = state[\"config\"].get(\"email_from\", \"no-reply@example.com\")\n\nnow = datetime.now(timezone.utc)\nrun_date = now.strftime(\"%Y-%m-%d\")\nstate[\"run\"][\"run_date\"] = run_date\nstate[\"run\"][\"run_started_at\"] = now.isoformat()\nstate[\"run\"][\"subject\"] = f\"eBay Fulfillment Run — {run_date} 8pm\"\n\n# Accumulators\nstate[\"run\"][\"orders_raw\"] = []\nstate[\"run\"][\"orders\"] = []\nstate[\"run\"][\"results\"] = []  # per-order outcomes\nstate[\"run\"][\"human_intervention_needed\"] = []\nstate[\"run\"][\"tool_errors\"] = []\nstate[\"run\"][\"counters\"] = {\n    \"fetched\": 0,\n    \"processed\": 0,\n    \"fulfilled\": 0,\n    \"partial\": 0,\n    \"on_hold\": 0,\n    \"failed\": 0,\n    \"skipped\": 0,\n}\n\nreturn state",
          "language": "python"
        }
      },
