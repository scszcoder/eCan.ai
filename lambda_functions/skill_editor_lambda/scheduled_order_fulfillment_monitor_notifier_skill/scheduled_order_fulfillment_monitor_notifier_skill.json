          "modelProvider": "OpenAI",
          "modelName": "gpt-4o-mini",
          "temperature": 0.2,
          "useThinking": false,
          "systemPrompt": "You normalize e-commerce order API responses into a strict internal schema. Output ONLY valid JSON.",
          "systemPromptId": "in-line",
          "prompt": "Normalize the following raw eBay orders response into this JSON shape:\n{\n  \"orders\": [\n    {\n      \"order_id\": \"\",\n      \"order_status\": \"\",\n      \"buyer\": {\"name\":\"\",\"email\":\"\"},\n      \"paid\": true,\n      \"created_at\": \"\",\n      \"last_updated_at\": \"\",\n      \"ship_to\": {\"name\":\"\",\"address1\":\"\",\"address2\":\"\",\"city\":\"\",\"state\":\"\",\"postal_code\":\"\",\"country\":\"\",\"phone\":\"\"},\n      \"items\": [\n        {\"line_id\":\"\",\"sku\":\"\",\"title\":\"\",\"quantity\":1,\"price\":0.0}\n      ],\n      \"already_shipped\": false,\n      \"cancelled\": false,\n      \"hold_flags\": [\"\"],\n      \"raw\": {}\n    }\n  ]\n}\nRules:\n- If a field is missing, use empty string/false/[] as appropriate.\n- Derive already_shipped/cancelled/hold_flags from any signals available.\n- Put the original order JSON into raw.\n\nRaw response JSON:\n{{{{tool_result}}}}",
          "promptId": "in-line",
          "promptSelection": "inline",
          "attachments": [],
          "apiKey": "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        }
