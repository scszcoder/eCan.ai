          "code": "summ = state.get('result', {}).get('llm_result', {}) or {}\n\n# Prefer LLM-produced subject/body; fallback to earlier subject\nstate['run']['subject'] = summ.get('subject') or state['run'].get('subject')\nstate['run']['summary'] = summ.get('body_text') or state['run'].get('summary') or ''\nstate['run']['summary_markdown'] = summ.get('body_markdown') or state['run'].get('summary_markdown') or state['run']['summary']\n\nreturn state",
