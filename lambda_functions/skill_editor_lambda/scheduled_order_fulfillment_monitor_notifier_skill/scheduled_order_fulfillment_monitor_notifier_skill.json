        "data": {
          "title": "code_compile_run_metrics",
          "code": "orders = state.get('result', {}).get('llm_result', {}).get('orders', [])\nstate['run']['counters']['fetched'] = len(orders)\n\n# Prepare a concise structured input for the summary LLM\nstate['run']['summary_input'] = {\n    'run_date': state['run'].get('run_date'),\n    'subject': state['run'].get('subject'),\n    'config': {\n        'max_orders_per_run': state['config'].get('max_orders_per_run'),\n        'include_statuses': state['config'].get('include_statuses'),\n        'do_label_creation': state['config'].get('do_label_creation'),\n        'do_mark_shipped': state['config'].get('do_mark_shipped'),\n    },\n    'counters': state['run'].get('counters', {}),\n    'results': state['run'].get('results', []),\n    'human_intervention_needed': state['run'].get('human_intervention_needed', []),\n    'tool_errors': state['run'].get('tool_errors', [])\n}\n\nreturn state",
          "language": "python"
