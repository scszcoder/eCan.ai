          "validation_regex": "^[0-9a-zA-Z]{10,}$",
          "description": "从当前聊天窗口提取用户ID"
        },
        {
          "priority": 2,
          "method": "url_pattern",
          "regex": "/uid=([0-9a-zA-Z]+)",
          "validation_regex": "^[0-9a-zA-Z]{10,}$",
          "description": "从URL参数提取"
        },
        {
          "priority": 3,
          "method": "dom_text",
          "selector": "div[class*='user-info']",
          "regex": "ID[:：]\\s*([0-9a-zA-Z]+)",
          "validation_regex": "^[0-9a-zA-Z]{10,}$",
          "description": "从用户信息文本提取"
        }
      ],
      "message_detection": {
        "container_selector": "div[class*='message-container']",
        "message_selector": "div[class*='msg-item']",
        "new_message_indicator": "span[class*='new-msg']",
