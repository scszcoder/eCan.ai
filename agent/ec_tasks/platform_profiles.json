        "message_text_selector": "div[class*='msg-content']",
        "timestamp_selector": "span[class*='msg-time']"
      },
      "polling_config": {
        "enabled": true,
        "interval_ms": 2500,
        "idle_interval_ms": 5000,
        "max_interval_ms": 10000,
        "snapshot_selector": "div[class*='message-container']",
        "change_detection": "dom_hash"
      }
    },

