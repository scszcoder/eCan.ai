          "div[class*='chat-container']"
        ],
        "required_elements": ["div[class*='message-list']"]
      },
      "event_strategy": {
        "primary": "websocket",
        "fallback": "polling",
        "cdp_events": [
          {
            "domain": "Network",
            "method": "Network.webSocketFrameReceived",
            "filter": "url contains 'wss://' AND url contains 'tiktok'",
            "reliability": "high",
            "priority": 1
          },
          {
            "domain": "Network",
            "method": "Network.responseReceived",
            "filter": "url contains '/api/customer_service'",
            "reliability": "medium",
            "priority": 2
          }
        ]
      },
      "chat_id_extraction": [
        {
          "priority": 1,
          "method": "event_payload",
          "path": "params.response.data.conversation_id",
          "validation_regex": "^[0-9]{15,}$",
          "description": "Extract from WebSocket/API payload"
        },
        {
          "priority": 2,
          "method": "dom_attribute",
          "selector": "div[class*='active-chat'], div[class*='selected-conversation']",
          "attribute": "data-conversation-id",
          "validation_regex": "^[0-9]{15,}$",
          "description": "Extract from active conversation"
        },
        {
          "priority": 3,
          "method": "url_pattern",
          "regex": "/conversation/([0-9]+)",
          "validation_regex": "^[0-9]{15,}$",
          "description": "Extract from URL"
        }
      ],
      "message_detection": {
        "container_selector": "div[class*='message-list']",
        "message_selector": "div[class*='message-item']",
        "new_message_indicator": "span[class*='unread']",
        "customer_name_selector": "span[class*='customer-name']",
        "message_text_selector": "div[class*='message-content']",
        "timestamp_selector": "span[class*='timestamp']"
      },
      "polling_config": {
        "enabled": true,
        "interval_ms": 2000,
        "idle_interval_ms": 5000,
        "max_interval_ms": 10000,
        "snapshot_selector": "div[class*='message-list']",
        "change_detection": "dom_hash"
      }
    },

