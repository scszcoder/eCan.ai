{
  "_schema_version": "1.0.0",
  "_description": "Platform-specific configurations for multi-customer chat monitoring. Each profile defines how to detect new messages and extract chat/customer IDs for different e-commerce platforms.",
  "_usage": "Profiles are automatically selected based on URL patterns and DOM signatures. Custom profiles can be added by users for unsupported platforms.",
  
  "profiles": {
    "amazon_seller_central": {
      "platform_id": "amazon_seller_central",
      "display_name": "Amazon Seller Central",
      "region": "global",
      "detection": {
        "url_patterns": [
          "sellercentral.amazon.com/messaging",
          "sellercentral.amazon.*/messaging",
          "sellercentral-*.amazon.com/messaging"
        ],
        "dom_signatures": [
          "div[data-test-id='message-thread']",
          "div[class*='messaging-inbox']"
        ],
        "required_elements": ["#message-inbox", "div[data-test-id='inbox-container']"]
      },
      "event_strategy": {
        "primary": "websocket",
        "fallback": "polling",
        "cdp_events": [
          {
            "domain": "Network",
            "method": "Network.webSocketFrameReceived",
            "filter": "url contains '/messaging/ws'",
            "reliability": "high",
            "priority": 1
          },
          {
            "domain": "Network",
            "method": "Network.responseReceived",
            "filter": "url contains '/api/messaging'",
            "reliability": "medium",
            "priority": 2
          }
        ]
      },
      "chat_id_extraction": [
        {
          "priority": 1,
          "method": "event_payload",
          "path": "params.response.payloadData.conversationId",
          "validation_regex": "^[A-Z0-9-]{20,}$",
          "description": "Extract from WebSocket payload"
        },
        {
          "priority": 2,
          "method": "dom_attribute",
          "selector": "div.active-conversation, div[data-selected='true']",
          "attribute": "data-conversation-id",
          "validation_regex": "^[A-Z0-9-]{20,}$",
          "description": "Extract from active conversation element"
        },
        {
          "priority": 3,
          "method": "url_pattern",
          "regex": "/conversations?/([A-Z0-9-]+)",
          "validation_regex": "^[A-Z0-9-]{20,}$",
          "description": "Extract from URL path"
        }
      ],
      "message_detection": {
        "container_selector": "div[data-test-id='message-list'], div[class*='message-thread']",
        "message_selector": "div[data-test-id='message-bubble'], div[class*='message-item']",
        "new_message_indicator": "span.unread-badge, div[class*='unread-count']",
        "customer_name_selector": "span.buyer-name, div[data-test-id='customer-name']",
        "message_text_selector": "div.message-content, div[data-test-id='message-text']",
        "timestamp_selector": "span.message-timestamp"
      },
      "polling_config": {
        "enabled": true,
        "interval_ms": 2000,
        "idle_interval_ms": 5000,
        "max_interval_ms": 10000,
        "snapshot_selector": "div[data-test-id='message-list']",
        "change_detection": "dom_hash"
      }
    },

    "ebay_messages": {
      "platform_id": "ebay_messages",
      "display_name": "eBay Messages",
      "region": "global",
      "detection": {
        "url_patterns": [
          "www.ebay.com/sh/messages",
          "www.ebay.*/sh/messages",
          "mesg.ebay.com"
        ],
        "dom_signatures": [
          "div[data-test-id='message-center']",
          "div.messages-container"
        ],
        "required_elements": ["div.inbox-container"]
      },
      "event_strategy": {
        "primary": "polling",
        "fallback": "polling",
        "cdp_events": [
          {
            "domain": "Network",
            "method": "Network.responseReceived",
            "filter": "url contains '/api/messages' OR url contains '/sh/api/inbox'",
            "reliability": "medium",
            "priority": 1
          }
        ]
      },
      "chat_id_extraction": [
        {
          "priority": 1,
          "method": "dom_attribute",
          "selector": "div.message-thread-selected, div[aria-selected='true']",
          "attribute": "data-thread-id",
          "validation_regex": "^[0-9]{10,}$",
          "description": "Extract from selected thread"
        },
        {
          "priority": 2,
          "method": "url_pattern",
          "regex": "/messages/([0-9]+)",
          "validation_regex": "^[0-9]{10,}$",
          "description": "Extract from URL"
        },
        {
          "priority": 3,
          "method": "event_payload",
          "path": "params.response.threadId",
          "validation_regex": "^[0-9]{10,}$",
          "description": "Extract from API response"
        }
      ],
      "message_detection": {
        "container_selector": "div.message-thread-container",
        "message_selector": "div.message-item",
        "new_message_indicator": "span.unread-indicator",
        "customer_name_selector": "span.buyer-username",
        "message_text_selector": "div.message-body",
        "timestamp_selector": "time.message-time"
      },
      "polling_config": {
        "enabled": true,
        "interval_ms": 2000,
        "idle_interval_ms": 5000,
        "max_interval_ms": 8000,
        "snapshot_selector": "div.message-thread-container",
        "change_detection": "dom_hash"
      }
    },

    "tiktok_shop": {
