{
  "ruleset_id": "feed_v1",
  "version": "1.0.0",
  "source": "spec A10 step 2/7 and DTC-09. Tables from prepare.feed_tables: 'account' (one row) and 'items'",
  "rules": [
    {"id": "feed.account_issue", "table": "account", "entity": "account", "id_field": "scope",
     "when": "account_issue_count > 0",
     "action": {"severity": "immediate", "owner": "user",
                "fix": "Open Merchant Center > Needs attention and fix each account issue; business identity fixes are yours to make"},
     "judgment": "Merchant Center reports {account_issue_count} account-level issue(s)", "evidence": ["account_issues"]},
    {"id": "feed.policy_pages_missing", "table": "account", "entity": "account", "id_field": "scope",
     "when": "len(missing_policy_pages) > 0",
     "action": {"severity": "immediate", "owner": "user",
                "fix": "Add the missing policy pages and link them in the store footer: their absence is the usual cause of 'misrepresentation' suspensions"},
     "judgment": "Missing policy pages: {missing_policy_pages}", "evidence": ["missing_policy_pages"]},
    {"id": "feed.item_disapproved", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "status in ['disapproved', 'not_approved', 'limited', 'pending'] or issue_text != ''",
     "action": {"severity": "same_day", "owner": "agent", "fix": "{issue_text}"},
     "judgment": "{item_id} is {status}: {issue_text}", "evidence": ["status", "issue_text"]},
    {"id": "feed.no_identifier", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "has_identifier == False",
     "action": {"severity": "same_day", "owner": "agent",
                "fix": "Add the GTIN (barcode), or brand + MPN; for custom or handmade goods set identifier_exists = no"},
     "judgment": "{item_id} has no GTIN and no brand + MPN", "evidence": ["gtin", "brand", "mpn"]},
    {"id": "feed.no_image", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "has_image == False",
     "action": {"severity": "same_day", "owner": "user", "fix": "Add a clean primary image (no text or watermark)"},
     "judgment": "{item_id} has no image", "evidence": ["has_image"]},
    {"id": "feed.title_long", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "title_len > title_max",
     "action": {"severity": "observe", "owner": "agent", "fix": "Shorten the title to {title_max} characters, key words first"},
     "judgment": "{item_id}'s title is {title_len} characters (limit {title_max})", "evidence": ["title_len"]},
    {"id": "feed.title_promo", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "title_promo == True or title_caps_share > 0.5",
     "action": {"severity": "same_day", "owner": "agent", "fix": "Remove promotional text and capitals from the title"},
     "judgment": "{item_id}'s title has promotional text or is mostly capitals", "evidence": ["title_promo", "title_caps_share"]},
    {"id": "feed.no_category", "table": "items", "entity": "product", "id_field": "item_id", "name_field": "title",
     "when": "google_product_category == None",
     "action": {"severity": "observe", "owner": "agent", "fix": "Set the Google product category"},
     "judgment": "{item_id} has no product category", "evidence": ["google_product_category"]}
  ]
}
