# Copy to deploy/ks/.env and fill in. Never commit the real file.

# --- private plane ---------------------------------------------------------
POSTGRES_PASSWORD=change-me
KS_LOCAL_SECRET=generate-with-openssl-rand-hex-32
# First owner (local sign-in). Remove after inviting real admins.
KS_BOOTSTRAP_ADMIN=admin@yourcompany.com:change-me-too
KS_BOOTSTRAP_TENANT=Your Company

# Weights pre-downloaded into this folder (one sub-folder per model)
MODELS_DIR=./models
LLM_MODEL=Qwen3-30B-A3B-Instruct-FP8
EMBED_MODEL=Qwen3-Embedding-8B
RERANK_MODEL=Qwen3-Reranker-4B
VLM_MODEL=Qwen2.5-VL-32B-Instruct-AWQ

# Accept the eCan app's cloud sign-in (optional; leave empty for local accounts only)
KS_COGNITO_REGION=
KS_COGNITO_POOL_ID=
KS_COGNITO_CLIENT_ID=
# Or an enterprise / CloudBase OIDC issuer
KS_OIDC_ISSUER=
KS_OIDC_AUDIENCE=

# --- public plane ------------------------------------------------------------
KS_DB_URL=
KS_EMBED_BASE_URL=
KS_EMBED_MODEL=
KS_EMBED_API_KEY=
