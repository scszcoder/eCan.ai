#!/bin/bash
# CloudBase HTTP cloud function entry: start the Knowledge Service on :9000.
export PYTHONPATH="/var/user:/var/user/vendor:${PYTHONPATH}"
export PYTHONUTF8=1 PYTHONUNBUFFERED=1
export KS_INLINE_JOBS=1            # instances freeze between requests: no background threads
export KS_DATA_DIR="${KS_DATA_DIR:-/tmp/ks}"
mkdir -p "$KS_DATA_DIR"
for py in /var/lang/python310/bin/python3.10 /var/lang/python310/bin/python3 /var/lang/python3/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" -m knowledge.ks.server --host 0.0.0.0 --port 9000
  fi
done
echo "no python interpreter found" >&2
exit 1
