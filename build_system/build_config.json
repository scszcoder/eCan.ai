    "enabled": true,
    "frontend_cache": true,
    "core_cache": false,
    "dependency_cache": true,
    "platform_overrides": {
      "macos": {
        "core_cache": false,
        "reason": "Disabled due to symlink conflicts with frameworks"
      }
    }
  },
  "_field_definitions": {
    "collect_all": "Packages to collect completely using PyInstaller collect_all() - collects all data files, binaries, and hidden imports. Only use for packages without built-in PyInstaller hooks.",
    "collect_data_only": "Packages to collect data files only - uses collect_data_files() to collect only data files, not binaries. Use for packages that only need data files.",
    "hiddenimports": "Hidden import modules - added to PyInstaller hiddenimports list. Use for dynamically imported modules that PyInstaller cannot detect through static analysis.",
    "excludes": "Modules and packages to exclude - reduces build size by excluding unnecessary modules. Use for test frameworks, development tools, and unnecessary large packages."
