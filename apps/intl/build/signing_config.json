{
  "_description": "Intl app 代码签名配置（使用标准 Developer ID）",
  "windows": {
    "enabled": true,
    "method": "azure_trusted_signing",
    "azure_trusted_signing": {
      "endpoint": "${AZURE_SIGNING_ENDPOINT}",
      "account": "${AZURE_SIGNING_ACCOUNT}",
      "profile": "${AZURE_SIGNING_PROFILE}"
    }
  },
  "macos": {
    "enabled": true,
    "identity": "Developer ID Application: eCan.AI Inc.",
    "entitlements": "../../resource/entitlements.plist",
    "notarization": {
      "apple_id": "${APPLE_NOTARIZATION_APPLE_ID}",
      "team_id": "${APPLE_NOTARIZATION_TEAM_ID}",
      "app_password": "${APPLE_NOTARIZATION_APP_PASSWORD}"
    }
  },
  "linux": {
    "enabled": false
  }
}
