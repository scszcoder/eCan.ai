### This is sample file of .env

###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='eCan.ai Graph KB'
WEBUI_DESCRIPTION="eCan.ai RAG System"
# WORKERS=2
### gunicorn worker timeout (default LLM request timeout if LLM_TIMEOUT is not set)
# TIMEOUT=150
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

### Optional SSL Configuration
# SSL=true
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

### Path Prefix Configuration (Optional)
### Used to host multiple LightRAG instances on one host behind a reverse proxy
### that routes by site prefix. Leave unset for single-instance deployment.
# LIGHTRAG_API_PREFIX=/site01

### CORS allowed origins for browser cross-origin requests. Defaults to "*"
### (any origin). The bundled WebUI is served same-origin and does not need
### this; set an explicit allowlist only when a different-origin web app calls
### the API from a browser. Credentialed (cookie) cross-origin requests are
### only enabled for an explicit allowlist, never for the "*" wildcard.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

### Interactive API documentation (Swagger UI /docs, ReDoc /redoc and the
### /openapi.json schema). Set to false to disable all of them (each returns
### 404) — recommended for hardened production deployments. The WebUI hides
### its API-docs entry point automatically based on /health.
# ENABLE_API_DOCS=true

### Directory Configuration (defaults to current working directory)
### Default value is ./inputs and ./rag_storage
# INPUT_DIR=<absolute_path_for_doc_input_dir>
# WORKING_DIR=<absolute_path_for_working_dir>

### Tiktoken cache directory (Store cached files in this folder for offline deployment)
# TIKTOKEN_CACHE_DIR=/app/data/tiktoken

### Ollama Emulating Model and Tag
# OLLAMA_EMULATING_MODEL_NAME=lightrag
OLLAMA_EMULATING_MODEL_TAG=latest

### Max nodes for graph retrieval (Ensure WebUI local settings are also updated, which is limited to this value)
# MAX_GRAPH_NODES=1000

### Logging level
LOG_LEVEL=INFO
# VERBOSE=False
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
### Logfile location (defaults to current working directory)
# LOG_DIR=/path/to/log/directory
# LIGHTRAG_PERFORMANCE_TIMING_LOGS=false

#####################################
### Login and API-Key Configuration
#####################################
# AUTH_ACCOUNTS='admin:admin123,user1:pass456'
# TOKEN_SECRET=Your-Key-For-LightRAG-API-Server
# TOKEN_EXPIRE_HOURS=48
# GUEST_TOKEN_EXPIRE_HOURS=24
# JWT_ALGORITHM=HS256

### Login brute-force protection
### After LOGIN_MAX_FAILED_ATTEMPTS failed attempts from same client IP + username
### within LOGIN_LOCKOUT_WINDOW_SECONDS, further attempts are rejected with HTTP 429
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_WINDOW_SECONDS=300

### Token Auto-Renewal (Sliding Window Expiration)
### Automatically renew tokens when remaining time < (total time * threshold)
# TOKEN_AUTO_RENEW=true
# TOKEN_RENEW_THRESHOLD=0.5

### API-Key to access LightRAG Server API
### Use this key in HTTP requests with the 'X-API-Key' header
# LIGHTRAG_API_KEY=your-secure-api-key-here
### Paths exempt from authentication (prefix match with /*)
# WHITELIST_PATHS=/health,/api/*

######################################################################################
### Query Configuration
###
### How to control the context length sent to LLM:
###    MAX_ENTITY_TOKENS + MAX_RELATION_TOKENS < MAX_TOTAL_TOKENS
###    Chunk_Tokens = MAX_TOTAL_TOKENS - Actual_Entity_Tokens - Actual_Relation_Tokens
######################################################################################
### LLM response cache for query (Not valid for streaming response)
ENABLE_LLM_CACHE=true
### Cosine similarity threshold for vector retrieval (industry standard: 0.3-0.5)
### Too low returns noise, too high misses relevant content
COSINE_THRESHOLD=0.35
### Number of entities or relations retrieved from KG (industry standard: 10-20)
### 8K-context LLM: reduce to 8 so entity context fits alongside chunks in the
### ~6.7K-token retrieval share. 12 caused LLM prompt to bloat and generation
### to take 10-30s. 8 keeps top-90% recall on the resume/CRM workloads we serve.
TOP_K=8
### Maximum number of chunks for naive vector search (industry standard: 20-50, BGE-M3 recommended: 32)
CHUNK_TOP_K=18
### Control the actual entities sent to LLM (8000 recommended for large context models)
MAX_ENTITY_TOKENS=8000
### Control the actual relations sent to LLM (10000 recommended for large context models)
MAX_RELATION_TOKENS=10000
### Control the maximum tokens sent to LLM (includes entities, relations and chunks)
### For models with 32K context like Qwen3-Next-80B: 3800 is recommended
MAX_TOTAL_TOKENS=3800

### chunk selection strategies
###     VECTOR: Pick KG chunks by vector similarity, delivered chunks to the LLM aligning more closely with naive retrieval
###     WEIGHT: Pick KG chunks by entity and chunk weight, delivered more solely KG related chunks to the LLM
###     If reranking is enabled, the impact of chunk selection strategies will be diminished.
### VECTOR recommended when rerank is enabled
# KG_CHUNK_PICK_METHOD=VECTOR

### Append each chunk's heading path (parent headings joined by " → ") as a
### `content_headings` field in the chunk JSON sent to the LLM. Costs extra tokens.
# ENABLE_CONTENT_HEADINGS=true

#########################################################
### Reranking configuration
### RERANK_BINDING type: null, cohere, jina, aliyun
### For rerank model deployed by vLLM use cohere binding
#########################################################
RERANK_BINDING=ecanai
RERANK_MODEL=gte-rerank
RERANK_BINDING_HOST=https://sccb0-d0gc5398xf028be6a.service.tcloudbase.com/api/llm-proxy/v1
RERANK_BINDING_API_KEY=
### Enable rerank by default in query params when RERANK_BINDING is not null (recommended when rerank is configured)
RERANK_BY_DEFAULT=True

### Rerank concurrency and timeout (independent from base LLM settings)
### MAX_ASYNC_RERANK falls back to MAX_ASYNC_LLM when unset
### RERANK_TIMEOUT default is 30s since reranker calls are much shorter than full LLM generation
# MAX_ASYNC_RERANK=4
# RERANK_TIMEOUT=30
### Rerank score threshold (industry standard: 0.3)
### After normalization, scores are in [0,1] range, so 0.3-0.5 works for most models
MIN_RERANK_SCORE=0.3

### For local deployment with vLLM or ryoais
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_MODEL=bge-reranker-v2-m3-GGUF/bge-reranker-v2-m3-Q8_0.gguf
# RERANK_BINDING_HOST=http://localhost:8000/v1/rerank
# RERANK_BINDING_API_KEY=your_rerank_api_key_here

### Default value for Cohere AI
# RERANK_MODEL=rerank-v3.5
# RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
# RERANK_BINDING_API_KEY=your_rerank_api_key_here

### Default value for Jina AI
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_BINDING_API_KEY=your_rerank_api_key_here

### Default value for Aliyun
# RERANK_MODEL=gte-rerank-v2
# RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_BINDING_API_KEY=your_rerank_api_key_here

### Aliyun Dashscope qwen3-rerank series — flat (Cohere-style) payload format
### The qwen3-rerank models expect a flat body {"model", "query", "documents", "top_n", ...}
### and return top-level "results", identical to the standard Cohere format. They are
### also served from a DIFFERENT, Cohere-compatible endpoint (/compatible-api/v1/reranks)
### — NOT the .../text-rerank/text-rerank path used by gte-rerank-* above.
### So use RERANK_BINDING=cohere (NOT aliyun) and point RERANK_BINDING_HOST at that endpoint.
# RERANK_BINDING=cohere
# RERANK_MODEL=qwen3-rerank
# RERANK_BINDING_HOST=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# RERANK_BINDING_API_KEY=your_api_key_here

### Cohere AI rerank chunking (token-limited models like ColBERT)
### RERANK_MAX_TOKENS_PER_DOC must be an integer >= 1; the server refuses to start otherwise.
### Defaults to 4096 (Cohere rerank-v3.5) when unset; 480 suits 512-token models.
# RERANK_ENABLE_CHUNKING=true
# RERANK_MAX_TOKENS_PER_DOC=480

########################################
### Document processing configuration
########################################
ENABLE_LLM_CACHE_FOR_EXTRACT=true

### Document processing output language: English, Chinese, French, German ...
SUMMARY_LANGUAGE="English, Chinese"

### Enable JSON-structured output for entity extraction
### JSON output incurs higher latency but delivers improved reliability
# ENTITY_EXTRACTION_USE_JSON=true

### Optional external YAML profile for entity type guidance and extraction examples
### Profiles are loaded from PROMPT_DIR/entity_type (PROMPT_DIR defaults to ./prompts).
### A reference template is shipped at lightrag's own prompts/samples/ dir.
### ENTITY_TYPE_PROMPT_FILE replaces the deprecated ENTITY_TYPES variable (LightRAG 1.5.0+).
# ENTITY_TYPE_PROMPT_FILE=entity_type_prompt.yml
# PROMPT_DIR=<absolute_path_for_prompt_dir>

### File upload size limit in bytes (default: 104857600 = 100MB, 0 = unlimited)
# MAX_UPLOAD_SIZE=104857600

### PDF decryption password for protected PDF files
# PDF_DECRYPT_PASSWORD=your_pdf_password_here

##################################################################################
### Document processing pipeline (LightRAG 1.5+ native parser + chunking selection)
###
### LIGHTRAG_PARSER routes each file suffix to a (parser, options) pair. The
### upstream default for native files (docx, md, pdf, image, …) is `native-teP`
### (native parser, no VLM, default chunking, paragraph semantic) and for legacy
### Office/ebook formats it is `legacy-R` (Recursive character splitter).
###
### Common chunker option codes: F=Fixed-token, R=Recursive, V=Semantic vector,
### P=Paragraph semantic, C=Markdown-aware.
### Engine codes: legacy, native, mineru, docling.
### Modifiers on engine tokens: (i) images, (t) tables, (e) equations,
### (drop_rf) drop redundant fields, (smart_heading) opt into Smart Heading.
###
### See docs/FileProcessingPipeline.md for the full grammar.
### Examples (uncomment one to override the default below):
###   # Use MinerU for every format it supports, then fall back to native/legacy
###   # LIGHTRAG_PARSER=*:mineru-teP,*:native-teP,*:legacy-R
###   # Force Smart Heading for DOCX (requires spaCy models; startup will verify)
###   # LIGHTRAG_PARSER=docx:native(smart_heading)-iteP,*:native-teP,*:legacy-R
###
### eCan 设置页的「文档解析」引擎选择不会写入独立变量，而是把上面这些
### 预设路由表写进 LIGHTRAG_PARSER（native=*:native-teP,*:legacy-R；
### mineru=*:mineru-teP,*:native-teP,*:legacy-R；
### docling=*:docling-teP,*:native-teP,*:legacy-R）。
### 注意：只要规则里出现 mineru/docling，启动前必须配置对应端点
### （mineru→按 MINERU_API_MODE 配置 MINERU_LOCAL_ENDPOINT 或
### MINERU_API_TOKEN、docling→DOCLING_ENDPOINT + DOCLING_API_KEY），
### 否则 LightRAG 启动校验会失败。
LIGHTRAG_PARSER=*:native-teP,*:legacy-R

### Concurrent parse workers per engine (LightRAG 1.5.5+)
### These bound how many files are parsed in parallel for each backend.
### Upstream defaults: 5 (native), 2 (mineru), 2 (docling). Raise for beefier hardware.
# MAX_PARALLEL_PARSE_NATIVE=5
# MAX_PARALLEL_PARSE_MINERU=2
# MAX_PARALLEL_PARSE_DOCLING=2

### Decompression / zip-bomb budgets (advanced — only raise for legit documents)
### Native DOCX/PPTX/XLSX archives are bounded by uncompressed size + ratio.
# DOCX_MAX_UNCOMPRESSED_BYTES=536870912
# DOCX_MAX_COMPRESSION_RATIO=100
# DOCX_RATIO_FLOOR_BYTES=16777216
# DOCX_MAX_ENTRIES=10000

### Embedded image budgets (native DOCX)
# NATIVE_DOCX_IMAGE_MAX_BYTES=26214400
# NATIVE_DOCX_IMAGE_MAX_TOTAL_BYTES=67108864

### Result-bundle zip-bomb budgets (external parser engines: docling/mineru)
# PARSER_RESULT_BUNDLE_MAX_ENTRIES=10000
# PARSER_RESULT_BUNDLE_MAX_TOTAL_BYTES=536870912
# PARSER_RESULT_BUNDLE_DOWNLOAD_TIMEOUT=300
# PARSER_RESULT_BUNDLE_DOWNLOAD_MAX_BYTES=536870912

##################################################################################
### Smart Heading for native DOCX (LightRAG 1.5.5+)
###
### When true, .docx files routed to native get smart_heading enabled by default;
### opt out per-file with native(smart_heading=false). Enabling this makes the
### server verify pinned spaCy models at startup and fail fast if missing.
### Applies to NEW uploads only — already-ingested documents keep persisted params.
# DOCX_SMART_HEADING=true

### Smart Heading tuning (advanced; the values shown ARE the upstream defaults)
### Skip Smart Heading for documents shorter than this many tokens.
# DOCX_SMART_MIN_TOKENS=1800
### Sub-document floor (defaults to min(1000, DOCX_SMART_MIN_TOKENS)).
# DOCX_SMART_SUBDOC_MIN_TOKENS=1000
### Heading-detection sensitivity.
# DOCX_SMART_DENSITY_MAX=0.40
# DOCX_SMART_DENSITY_BASELINE_MARGIN=0.10
# DOCX_SMART_MIN_INTER_HEADING_CHARS=200
# DOCX_SMART_HEADING_MAX_CHARS=180
### TOC retention (visible lines kept before collapsing to "……").
# DOCX_SMART_TOC_KEEP_LINES=5
### Locale-specific caption / imprint prefixes (comma-separated).
# DOCX_SMART_CAPTION_PREFIXES=图,表,公式,Figure,Table,Fig.,Eq.,Chart
# DOCX_SMART_IMPRINT_COLON_PREFIXES=抄送,主题词
# DOCX_SMART_IMPRINT_CLOSER_PREFIXES=印发,印发机关
# DOCX_SMART_IMPRINT_CLOSER_TRAILING=印发
# DOCX_SMART_IMPRINT_FORWARD_PARAS=3
### Title-block detection.
# DOCX_SMART_TITLE_BLOCK_MIN_DELTA=2.0
# DOCX_SMART_LLM_WINDOW_TOKENS=1000
# DOCX_SMART_TITLE_HEAD_ZONE_RECORDS=8

##################################################################################
### Native Markdown (.md / .textpack) remote image handling (LightRAG 1.5.6+)
###
### External http(s) images in markdown are downloaded and embedded into sidecar
### assets by default (SSRF-guarded). Set ENABLED=false to drop them instead.
NATIVE_MD_IMAGE_DOWNLOAD_ENABLED=true
# NATIVE_MD_IMAGE_DOWNLOAD_REQUIRED=false
# NATIVE_MD_IMAGE_DOWNLOAD_TIMEOUT=30
# NATIVE_MD_IMAGE_MAX_BYTES=26214400
# NATIVE_MD_IMAGE_MAX_SVG_PIXELS=16000000
# NATIVE_MD_IMAGE_MAX_TOTAL_BYTES=67108864
# NATIVE_MD_IMAGE_MAX_REQUESTS=100
# NATIVE_MD_IMAGE_DOWNLOAD_TOTAL_TIMEOUT=120
### Escape hatch for the SSRF guard: comma-separated CIDRs/IPs that are normally
### blocked but should be allowed (e.g. an internal image host).
# NATIVE_MD_IMAGE_ALLOWED_NON_PUBLIC_CIDRS=10.0.0.0/8,192.168.1.5
### Force re-download (discard .native_raw/ cache) for re-parse
# LIGHTRAG_FORCE_REPARSE_NATIVE=false

##################################################################################
### External parser engines: MinerU (multimodal PDF/Office)
##################################################################################
### API protocol: official (MinerU v4 API) or local (self-hosted mineru-api).
### These names and defaults match LightRAG 1.5.6.
MINERU_API_MODE=local
# MINERU_POLL_INTERVAL_SECONDS=2
# MINERU_MAX_POLLS=600

### Parse options shared by both modes.
MINERU_MODEL_VERSION=pipeline
# MINERU_IS_OCR=false
# MINERU_LANGUAGE=ch
# MINERU_ENABLE_TABLE=true
# MINERU_ENABLE_FORMULA=true
# MINERU_PAGE_RANGES=

### Suffixes your MinerU endpoint can handle on top of the baseline set.
### Pair each one with a routing rule (LIGHTRAG_PARSER=doc:mineru) to be effective.
# MINERU_ADDITIONAL_SUFFIXES=doc,xls,ppt

### Local mode
MINERU_LOCAL_ENDPOINT=http://127.0.0.1:8000
### hybrid-auto-engine (default), pipeline (CPU-only), vlm-auto-engine
MINERU_LOCAL_BACKEND=hybrid-auto-engine
### auto | txt | ocr; ignored by VLM-only backends.
MINERU_LOCAL_PARSE_METHOD=auto
MINERU_LOCAL_IMAGE_ANALYSIS=false
# MINERU_LOCAL_START_PAGE_ID=0
# MINERU_LOCAL_END_PAGE_ID=99999

### API token shared by official and authenticated local/custom services.
# MINERU_API_TOKEN=your-api-key
### Official mode. The UI may change the endpoint value, but keeps these
### LightRAG-native variable names unchanged.
# MINERU_OFFICIAL_ENDPOINT=https://mineru.net

### Force re-upload to MinerU on every retry (disables cache)
# LIGHTRAG_FORCE_REPARSE_MINERU=false

### MinerU raw-bundle cache controls (.mineru_raw/)
# MINERU_ENGINE_VERSION=
# MINERU_BBOX_ATTRIBUTES={"origin":"LEFTTOP","max":1000}

##################################################################################
### External parser engines: Docling (docling-serve v1 / async API)
##################################################################################
### Endpoint is BASE URL only — the client appends /v1/convert/file/async,
### /v1/status/poll/{task_id}, /v1/result/{task_id}.
DOCLING_ENDPOINT=http://localhost:5001
# A custom deployment changes only the DOCLING_ENDPOINT value.
# eCan's LightRAG runtime adapter sends this value as Authorization: Bearer.
DOCLING_API_KEY=
DOCLING_DO_OCR=true
DOCLING_FORCE_OCR=true
DOCLING_DO_FORMULA_ENRICHMENT=false
# DOCLING_ADDITIONAL_SUFFIXES=doc,ppt,xls
# DOCLING_OCR_ENGINE=auto
# DOCLING_OCR_PRESET=auto
# DOCLING_OCR_LANG=
# DOCLING_POLL_INTERVAL_SECONDS=5
# DOCLING_MAX_POLLS=240
# DOCLING_BBOX_ATTRIBUTES={"origin":"LEFTBOTTOM"}
# DOCLING_ENGINE_VERSION=
### Force re-upload to Docling on every retry (disables cache)
# LIGHTRAG_FORCE_REPARSE_DOCLING=false

### Chunk size for document splitting (500-1500 recommended, 1200 is a balanced value)
CHUNK_SIZE=1200
### Chunk overlap size (100-150 recommended to ensure context continuity)
CHUNK_OVERLAP_SIZE=120

### Per-chunker-strategy overrides (LightRAG 1.5+)
### Each chunker selector (F / R / V / P) honors its own size / overlap var.
### F (Fixed-token) — global fallback when CHUNK_F_SIZE is unset.
# CHUNK_F_SIZE=1200
# CHUNK_F_OVERLAP_SIZE=120
# CHUNK_F_SPLIT_BY_CHARACTER=
# CHUNK_F_SPLIT_BY_CHARACTER_ONLY=false
### R (Recursive character) — CJK-aware cascade default; override only if needed.
# CHUNK_R_SIZE=1200
# CHUNK_R_OVERLAP_SIZE=120
# CHUNK_R_SEPARATORS=["\n\n","\n","。","！","？","；","，"," ",""]
### V (Semantic vector) — inherits CHUNK_SIZE; V has no overlap.
# CHUNK_V_SIZE=1200
# CHUNK_V_BREAKPOINT_THRESHOLD_TYPE=percentile
# CHUNK_V_BREAKPOINT_THRESHOLD_AMOUNT=
# CHUNK_V_BUFFER_SIZE=1
# CHUNK_V_SENTENCE_SPLIT_REGEX=(?<=[.?!])\s+|(?<=[。？！])
### P (Paragraph semantic) — DOES NOT inherit CHUNK_SIZE; defaults to 2000.
# CHUNK_P_SIZE=800
# CHUNK_P_OVERLAP_SIZE=100

### Embedding-side overlap borrowed from previous chunk's tail when an over-limit
### chunk still has to be token-window-split after chunking.
# EMBEDDING_CHUNK_OVERLAP_TOKEN_SIZE=100

### Number of summary segments or tokens to trigger LLM summary on entity/relation merge (at least 3 is recommended)
# FORCE_LLM_SUMMARY_ON_MERGE=8
### Max description token size to trigger LLM summary
# SUMMARY_MAX_TOKENS=1200
### Recommended LLM summary output length in tokens
# SUMMARY_LENGTH_RECOMMENDED=600
### Maximum context size sent to LLM for description summary
# SUMMARY_CONTEXT_SIZE=12000
### Maximum token size allowed for entity extraction input context
# MAX_EXTRACT_INPUT_TOKENS=20480

### control the maximum chunk_ids stored in vector and graph db
### Addresses the hard-coded 64KB size constraint for Milvus dynamic field ($meta)
# MAX_SOURCE_IDS_PER_ENTITY=200
# MAX_SOURCE_IDS_PER_RELATION=200
### control chunk_ids limitation method: FIFO, KEEP
###    FIFO: First in first out
###    KEEP: Keep oldest (less merge action and faster, default)
# SOURCE_IDS_LIMIT_METHOD=KEEP

### Maximum number of file paths stored in entity/relation file_path field
### (For displayed only, does not affect query performance)
# MAX_FILE_PATHS=75

### maximum number of related chunks per source entity or relation
###     The chunk picker uses this value to determine the total number of chunks selected from KG(knowledge graph)
###     Higher values increase re-ranking time
RELATED_CHUNK_NUMBER=5

###############################
### Concurrency Configuration
###############################
### Max concurrency requests of LLM (for both query and document processing)
### MAX_ASYNC is still accepted as a deprecated alias
### Conservative default (6) balances throughput and stability for cloud providers:
###   - OpenAI / Azure / Anthropic: 4-8 is safe; raise to 8-12 if your tier allows
###   - For remote Ollama servers, lower to 2-3 to improve cancellation responsiveness
###   - For quantized 27B+ models behind a remote gateway, lower to 2 to avoid 502/429
###   - eCan's launcher wraps chat.completions.create with retry (3x exponential
###     backoff for 429 / timeout / connection errors) so transient spikes are
###     absorbed before they abort a document.
MAX_ASYNC_LLM=6
### Number of parallel processing documents (between 2~10, MAX_ASYNC_LLM/3 is recommended)
MAX_PARALLEL_INSERT=2
### Max concurrency requests for Embedding
### Conservative default (2) covers most remote embedding endpoints (OpenAI, Voyage, Cohere).
###   - For remote Ollama servers, use 8 to avoid server crashes
###   - For local Ollama, use 16-24 if you have the CPU/RAM
EMBEDDING_FUNC_MAX_ASYNC=2
### Num of chunks send to Embedding in single request
EMBEDDING_BATCH_NUM=8

### Entity extraction "gleaning" pass per chunk (eCan speed vs quality trade-off)
### Each chunk normally triggers a second LLM call asking it to keep extracting
### entities it may have missed. Set to 0 to skip the second pass entirely —
### ~50% wallclock speedup at the cost of missing ~5-10% of entities on long
### chunks. Short chunks (resumes, configs) lose almost nothing when disabled.
### Safe to leave at 0 for cloud APIs; raise to 1 only when retrieval recall on
### long technical / legal documents is more important than ingest throughput.
MAX_GLEANING=0

###########################################################################
### LLM Configuration
### LLM_BINDING type: openai, ollama, lollms, azure_openai, aws_bedrock, gemini
### LLM_BINDING_HOST: host only for Ollama, endpoint for other LLM service
### If LightRAG deployed in Docker:
###    uses host.docker.internal instead of localhost in LLM_BINDING_HOST
###########################################################################
### LLM request timeout setting for all llm (0 means no timeout for Ollama)
### For remote Ollama servers, use 180s; for local servers use 120s
# LLM_TIMEOUT=240

LLM_BINDING=ecanai
LLM_MODEL=
LLM_BINDING_HOST=https://sccb0-d0gc5398xf028be6a.service.tcloudbase.com/api/llm-proxy/v1
LLM_BINDING_API_KEY=

###########################################################################
### Role-specific LLM/VLM overrides
### Available roles: EXTRACT, KEYWORD, QUERY, VLM
### If unset, each role falls back to global LLM configuration above
### For detail refer to: docs/RoleSpecificLLMConfiguration.md
###########################################################################
# KEYWORD_LLM_MODEL=gpt-5.4-nano
# KEYWORD_MAX_ASYNC_LLM=4
# KEYWORD_LLM_TIMEOUT=60

# QUERY_LLM_MODEL=gpt-5.4
# QUERY_MAX_ASYNC_LLM=4
# QUERY_LLM_TIMEOUT=240

# VLM_LLM_MODEL=gpt-5.4-mini
# VLM_MAX_ASYNC_LLM=4
# VLM_LLM_TIMEOUT=300

### Master switch for VLM multimodal analysis (i/t/e items)
### When false, multimodal item is skipped regardless of document process_options
### When true, VLM_LLM_BINDING (or base LLM_BINDING) must be vision-capable
VLM_PROCESS_ENABLE=false
### Maximum image bytes sent to VLM (5242880=5MB)
VLM_MAX_IMAGE_BYTES=5242880
### Minimum image side (width or height) in pixels accepted for VLM analysis
### Images smaller than this are treated as decorative and skipped
VLM_MIN_IMAGE_PIXEL=64

### Azure OpenAI example
### Use deployment name as model name or set AZURE_OPENAI_DEPLOYMENT instead
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# LLM_BINDING=azure_openai
# LLM_BINDING_HOST=https://xxxx.openai.azure.com/
# LLM_BINDING_API_KEY=your_api_key
# LLM_MODEL=my-gpt-mini-deployment

### Openrouter example
# LLM_MODEL=google/gemini-2.5-flash
# LLM_BINDING_HOST=https://openrouter.ai/api/v1
# LLM_BINDING_API_KEY=your_api_key
# LLM_BINDING=openai

### Gemini example
# LLM_BINDING=gemini
# LLM_MODEL=gemini-flash-latest
# LLM_BINDING_API_KEY=your_gemini_api_key
# LLM_BINDING_HOST=https://generativelanguage.googleapis.com

### use the following command to see all support options for OpenAI, azure_openai or OpenRouter
### lightrag-server --llm-binding gemini --help
### Gemini Specific Parameters
# GEMINI_LLM_MAX_OUTPUT_TOKENS=9000
# GEMINI_LLM_TEMPERATURE=0.7
### Enable Thinking
# GEMINI_LLM_THINKING_CONFIG='{"thinking_budget": -1, "include_thoughts": true}'
### Disable Thinking
# GEMINI_LLM_THINKING_CONFIG='{"thinking_budget": 0, "include_thoughts": false}'

### OpenAI Specific Parameters
### Increased temperature values may mitigate infinite inference loops in certain LLM, such as Qwen3-30B.
# OPENAI_LLM_TEMPERATURE=0.9
### Set the max_tokens to mitigate endless output of some LLM
### max_output_token < LLM_TIMEOUT * llm_tokens_per_second
### i.e. max_output_token = 9000 < 240s * 50 tokens/s
### For vLLM/SGLang and most of OpenAI compatible API provider
# OPENAI_LLM_MAX_TOKENS=9000
### For OpenAI o1-mini or newer models utilize max_completion_tokens instead of max_tokens
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000
### OpenAI reasoning control
# OPENAI_LLM_REASONING_EFFORT=minimal
### OpenRouter reasoning control
# OPENAI_LLM_EXTRA_BODY='{"reasoning": {"enabled": false}}'
### Qwen3 reasoning control deploy by vLLM
# OPENAI_LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

### Ollama Server Specific Parameters
### OLLAMA_LLM_NUM_CTX must be provided, and should at least larger than MAX_TOTAL_TOKENS + 2000
### For entity extraction tasks with CHUNK_SIZE=1024, use 8192 (8x chunk size) for optimal performance
### For long document Q&A, use 16384 or higher
OLLAMA_LLM_NUM_CTX=8192
### Set the max_output_tokens to mitigate endless output of some LLM
OLLAMA_LLM_NUM_PREDICT=4096
### Stop sequences for Ollama LLM
# OLLAMA_LLM_STOP='["</s>", "<|EOT|>"]'

### Bedrock Specific Parameters
# BEDROCK_LLM_TEMPERATURE=1.0

#######################################################################################
### Embedding Configuration (Should not be changed after the first file processed)
### EMBEDDING_BINDING: ollama, openai, azure_openai, jina, lollms, aws_bedrock
### EMBEDDING_BINDING_HOST: host only for Ollama, endpoint for other Embedding service
### If LightRAG deployed in Docker:
###    uses host.docker.internal instead of localhost in EMBEDDING_BINDING_HOST
#######################################################################################
# EMBEDDING_TIMEOUT=30

### Control whether to send embedding_dim parameter to embedding API
### For OpenAI: Set to true to enable dynamic dimension adjustment
### For OpenAI: Set to false (default) to disable sending dimension parameter
### Note: Automatically ignored for backends that don't support dimension parameter (e.g., Ollama)

### Ollama embedding
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_BINDING_API_KEY=your_api_key
# EMBEDDING_BINDING_HOST=http://localhost:11434

### OpenAI compatible embedding
EMBEDDING_BINDING=ecanai
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=true
EMBEDDING_TOKEN_LIMIT=2048
EMBEDDING_BINDING_HOST=https://sccb0-d0gc5398xf028be6a.service.tcloudbase.com/api/llm-proxy/v1
EMBEDDING_BINDING_API_KEY=

### Control whether to use base64 encoding format for embeddings (improves performance for OpenAI)
### Set EMBEDDING_USE_BASE64=true (default) to use base64 encoding
### For Yandex Cloud and other providers that don't support it: Set EMBEDDING_USE_BASE64=false
# EMBEDDING_USE_BASE64=true

### Optional: asymmetric embeddings (query/document behavior split)
### Leave EMBEDDING_ASYMMETRIC unset or false to keep symmetric behavior
### Set true only when the selected embedding backend supports asymmetric mode
# EMBEDDING_ASYMMETRIC=true
### Prefix-based models such as BGE/E5/GTE require both prefix variables
### Wrap non-empty values with quotes if there are trailing spaces
### Use NO_PREFIX for a side that should intentionally have no prefix
# EMBEDDING_DOCUMENT_PREFIX="search_document: "
# EMBEDDING_QUERY_PREFIX="search_query: "

### Optional for Azure embedding
### Use deployment name as model name or set AZURE_EMBEDDING_DEPLOYMENT instead
# AZURE_OPENAI_EMBEDDING_API_VERSION=2024-08-01-preview
# EMBEDDING_BINDING=azure_openai
# EMBEDDING_BINDING_HOST=https://xxxx.openai.azure.com/
# EMBEDDING_API_KEY=your_api_key
# EMBEDDING_MODEL=my-text-embedding-3-large-deployment
# EMBEDDING_DIM=3072

### Gemini embedding
# EMBEDDING_BINDING=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536
# EMBEDDING_TOKEN_LIMIT=2048
# EMBEDDING_BINDING_HOST=https://generativelanguage.googleapis.com
# EMBEDDING_BINDING_API_KEY=your_api_key
# EMBEDDING_SEND_DIM=true

### Jina AI Embedding
# EMBEDDING_BINDING=jina
# EMBEDDING_BINDING_HOST=https://api.jina.ai/v1/embeddings
# EMBEDDING_MODEL=jina-embeddings-v4
# EMBEDDING_DIM=2048
# EMBEDDING_BINDING_API_KEY=your_api_key

### Ollama Embedding
OLLAMA_EMBEDDING_NUM_CTX=8192

####################################################################
### WORKSPACE sets workspace name for all storage types
### for the purpose of isolating data from LightRAG instances.
### Valid workspace name constraints: a-z, A-Z, 0-9, and _
####################################################################
WORKSPACE=default

############################
### Data storage selection
############################
### Default storage: JSON/Nano/NetworkX (Recommended for test deployment)
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

### Redis Storage (Recommended for production deployment)
# LIGHTRAG_KV_STORAGE=RedisKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage

### Vector Storage (Recommended for production deployment)
# LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
# LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_VECTOR_STORAGE=FaissVectorDBStorage

### Graph Storage (Recommended for production deployment)
# LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
# LIGHTRAG_GRAPH_STORAGE=MemgraphStorage

### PostgreSQL
# LIGHTRAG_KV_STORAGE=PGKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
# LIGHTRAG_VECTOR_STORAGE=PGVectorStorage

### MongoDB (Vector storage only available on Atlas Cloud)
# LIGHTRAG_KV_STORAGE=MongoKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=MongoDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=MongoGraphStorage
# LIGHTRAG_VECTOR_STORAGE=MongoVectorDBStorage

### PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD='your_password'
POSTGRES_DATABASE=your_database
POSTGRES_MAX_CONNECTIONS=12

### PostgreSQL Vector Storage Configuration
### Vector storage type: HNSW, HNSW_HALFVEC, IVFFlat, VCHORDRQ
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200
POSTGRES_IVFFLAT_LISTS=100
POSTGRES_VCHORDRQ_BUILD_OPTIONS=
POSTGRES_VCHORDRQ_PROBES=
POSTGRES_VCHORDRQ_EPSILON=1.9

### PostgreSQL Connection Retry Configuration (Network Robustness)
### NEW DEFAULTS (v1.4.10+): Optimized for HA deployments with ~30s switchover time
### Number of retry attempts (1-100, default: 10)
# POSTGRES_CONNECTION_RETRIES=10
### Initial retry backoff in seconds (0.1-300.0, default: 3.0)
# POSTGRES_CONNECTION_RETRY_BACKOFF=3.0
### Maximum retry backoff in seconds (default: 30.0)
# POSTGRES_CONNECTION_RETRY_BACKOFF_MAX=30.0
### Connection pool close timeout in seconds (default: 5.0)
# POSTGRES_POOL_CLOSE_TIMEOUT=5.0

### PostgreSQL SSL Configuration (Optional)
# POSTGRES_SSL_MODE=require
# POSTGRES_SSL_CERT=/path/to/client-cert.pem
# POSTGRES_SSL_KEY=/path/to/client-key.pem
# POSTGRES_SSL_ROOT_CERT=/path/to/ca-cert.pem
# POSTGRES_SSL_CRL=/path/to/crl.pem

### PostgreSQL Server Settings (for Supabase Supavisor)
# POSTGRES_SERVER_SETTINGS="options=reference%3D[project-ref]"
# POSTGRES_STATEMENT_CACHE_SIZE=100

### Neo4j Configuration
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='your_password'
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30
NEO4J_MAX_TRANSACTION_RETRY_TIME=30
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_LIVENESS_CHECK_TIMEOUT=30
NEO4J_KEEP_ALIVE=true

### MongoDB Configuration
# For MongoVectorDBStorage, MONGO_URI must point to a MongoDB endpoint with Atlas Search support
MONGO_URI=mongodb://root:root@localhost:27017/
MONGO_DATABASE=LightRAG

### Milvus Configuration
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=lightrag
# MILVUS_USER=root
# MILVUS_PASSWORD=your_password
# MILVUS_TOKEN=your_token

### Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-api-key

### Redis
REDIS_URI=redis://localhost:6379
REDIS_SOCKET_TIMEOUT=30
REDIS_CONNECT_TIMEOUT=10
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_ATTEMPTS=3

### Memgraph Configuration
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph

############################
### Evaluation Configuration
############################
### RAGAS evaluation models (used for RAG quality assessment)
### ⚠️ IMPORTANT: Both LLM and Embedding endpoints MUST be OpenAI-compatible
### Default uses OpenAI models for evaluation

### LLM Configuration for Evaluation
# EVAL_LLM_MODEL=gpt-4o-mini
# EVAL_LLM_BINDING_API_KEY=your_api_key
# EVAL_LLM_BINDING_HOST=https://api.openai.com/v1

### Embedding Configuration for Evaluation
# EVAL_EMBEDDING_MODEL=text-embedding-3-large
# EVAL_EMBEDDING_BINDING_API_KEY=your_embedding_api_key
# EVAL_EMBEDDING_BINDING_HOST=https://api.openai.com/v1

### Performance Tuning
### Number of concurrent test case evaluations
# EVAL_MAX_CONCURRENT=2
### TOP_K query parameter of LightRAG (default: 10)
# EVAL_QUERY_TOP_K=10
### LLM request retry and timeout settings for evaluation
# EVAL_LLM_MAX_RETRIES=5
# EVAL_LLM_TIMEOUT=180

##########################################################################
### Langfuse Observability Configuration
### Only works with LLM provided by OpenAI compatible API
### Install with: pip install lightrag-hku[observability]
##########################################################################
# LANGFUSE_SECRET_KEY=''
# LANGFUSE_PUBLIC_KEY=''
# LANGFUSE_HOST='https://cloud.langfuse.com'
# LANGFUSE_ENABLE_TRACE=true
