/build_system/certificates/

# Lambda deployment artifacts (build outputs — not source)
/lambda_functions/*.zip
/lambda_functions/*/*.zip

# TCB / cloud function deploy zips (build outputs)
/cloudbase-graphql/ecan-graphql-deploy.zip
/cloudbase-graphql/.deploy_tmp/

# TCB CLI cache (regenerated by tcb deploy)
/cloudbase-graphql/.tcb/

# GUI v2 auth callback page (generated by login flow, not source)
/gui_v2/public/auth/

# Version archives (keep versions.json, ignore zip files)
/cloudbase-graphql/.deploy_artifacts/
!/cloudbase-graphql/.deploy_artifacts/versions.json
/cloudbase-graphql/.deploy_artifacts/*.zip

# scf/ has its own .deploy_artifacts/ written by scf/scripts/deploy-api.sh
# (PROJECT_DIR shifted after the scf/ws split — the root .deploy_artifacts/
# is no longer the only archive location). Same policy: keep versions.json,
# ignore zip files.
/cloudbase-graphql/scf/.deploy_artifacts/
!/cloudbase-graphql/scf/.deploy_artifacts/versions.json
/cloudbase-graphql/scf/.deploy_artifacts/*.zip

# WS-only-detection milestone design docs (local, not committed)
WS*_SPEC.md

# CLI local session (may hold an auth token) + web-server PID — never commit
.ecan_session.json
.ecan-web.pid
.ecan_session.json.tmp

# TCB --source deploy: temporary backup of functions/ecan-graphql-ws/index.js
# while secrets (WS_PUSH_SECRET/ECAN_JWT_SECRET) are injected as placeholders
# for the cloud build. Should be auto-deleted by trap EXIT on script end.
# Ignored as belt-and-suspenders in case deploy is SIGKILLed.
**/*.tcb-bak
