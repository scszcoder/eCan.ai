# WeChat local user data directories
wechat_**_local/
# WeChat account-level data directories without _local suffix; mirrors of the
# *_local/ ones for the new MainGUI account partition layout.
wechat_6e57ba2509a39f06ee7aa467/
wechat_6e57ba2509a39f06ee7aa467_wechat_local/

# WeChat session token file (JWT, holds a long-lived session token).
# Generated by auth/auth_manager.py:_save_wechat_session_token — see
# _WECHAT_SESSION_TOKEN_FILE_PREFIX = ".wx_st". The base64 suffix encodes
# the username (e.g. wechat_<openid>). NEVER commit: it grants access to
# the user's account without re-auth.
.wx_st_*

# Phone-number-formatted local user data dirs from CloudBase phone login.
# CloudBase normalizes phone to "+86 13880917374"; MainGUI.py then uses
# this whole string as the local_part → log_user = "+86 13880917374_local".
# (each phone number is a different dir, so use a wildcard)
+86 *_local/

# Phone/email-based local user data directories (same pattern as below)
# Example: /249511118_qq_com/, /249511118@qq.com/, /liuqiang100_gmail_com/
*_yahoo_com/
*_qq_com/
*@qq.com/
*_gmail_com/
*_163_com/
*_outlook_com/

# Pure phone number directories (e.g., 13800138000/, 8613800138000_/, etc.)
[0-9]*/
*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9]*/
