{
  "validation_rules": {
    "OPENAI_API_KEY": {
      "prefix": "sk-",
      "min_length": 20,
      "description": "OpenAI API key"
    },
    "ANTHROPIC_API_KEY": {
      "prefix": "sk-ant-",
      "min_length": 20,
      "description": "Anthropic API key"
    },
    "DEEPSEEK_API_KEY": {
      "prefix": "sk-",
      "min_length": 20,
      "description": "DeepSeek API key"
    },
    "GEMINI_API_KEY": {
      "min_length": 20,
      "description": "Gemini API key"
    },
    "DASHSCOPE_API_KEY": {
      "min_length": 20,
      "description": "DashScope API key"
    },
    "AZURE_OPENAI_API_KEY": {
      "min_length": 20,
      "description": "Azure OpenAI API key"
    },
    "AZURE_ENDPOINT": {
      "min_length": 10,
      "pattern": "https://.*\\.openai\\.azure\\.com",
      "description": "Azure OpenAI endpoint URL"
    },
    "ARK_API_KEY": {
      "min_length": 20,
      "description": "Bytedance Doubao (Volcano Engine) API key"
    },
    "BAIDU_API_KEY": {
      "min_length": 20,
      "description": "Baidu Qianfan API key"
    },
    "ZHIPUAI_API_KEY": {
      "min_length": 20,
      "description": "ChatGLM API key"
    },
    "AWS_ACCESS_KEY_ID": {
      "min_length": 16,
      "max_length": 128,
      "description": "AWS Access Key ID for Bedrock"
    },
    "AWS_SECRET_ACCESS_KEY": {
      "min_length": 40,
      "description": "AWS Secret Access Key for Bedrock"
    },
    "OLLAMA_LLM_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "Ollama API key (optional)"
    },
    "OLLAMA_EMBEDDING_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "Ollama Embedding API key (optional)"
    },
    "OLLAMA_RERANK_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "Ollama Rerank API key (optional)"
    },
    "RYOAIS_LLM_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "RyoAIS LLM API key (optional)"
    },
    "RYOAIS_EMBEDDING_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "RyoAIS Embedding API key (optional)"
    },
    "RYOAIS_RERANK_API_KEY": {
      "min_length": 0,
      "optional": true,
      "description": "RyoAIS Rerank API key (optional)"
    }
  },
  "patterns": {
    "api_key_suffixes": ["_API_KEY", "_KEY", "_TOKEN", "_SECRET", "_PASSWORD"],
    "special_variables": ["AZURE_ENDPOINT", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"],
    "orphaned_patterns": ["VSCODE_DEBUGPY_ADAPTER_ENDPOINTS"]
  },
  "masking": {
    "show_prefix_chars": 8,
    "show_suffix_chars": 4,
    "min_length_for_masking": 12,
    "fallback_prefix_chars": 4
  }
}
