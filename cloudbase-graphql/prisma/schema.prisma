// Prisma Schema for eCan.ai CN Version
// Database: PostgreSQL on Tencent Cloud

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Core Entities ============

model Agent {
  id               String   @id @default(cuid())
  owner            String   @map("owner")
  name             String
  description      String?
  gender           String?
  birthday         String?
  avatarResourceId String?  @map("avatar_resource_id")
  capabilities     Json     @default("{}")
  personalities    Json     @default("[]")
  rank             String?
  status           String   @default("active")
  title            Json     @default("{}")
  supervisorId     String?  @map("supervisor_id")
  vehicleId        String?  @map("vehicle_id")
  url              String?
  version          String?
  orgId            String?  @map("org_id")
  orgIds           Json     @default("[]") @map("org_ids")
  skills           Json     @default("[]")
  tasks            Json     @default("[]")
  extraData        Json     @default("{}") @map("extra_data")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  skillRels    AgentSkillRel[]
  taskRels     AgentTaskRel[]
  toolRels     AgentToolRel[]
  orgRels      AgentOrgRel[]

  @@index([owner])
  @@index([status])
  @@index([orgId])
  @@map("agents")
}

model AgentSkill {
  id          String   @id @default(cuid())
  owner       String
  name        String
  description String?
  category    String?
  tags        Json     @default("[]")
  config      Json     @default("{}")
  capabilities Json    @default("[]")
  limitations Json     @default("[]")
  examples    Json     @default("[]")
  diagram     Json     @default("{}")
  inputModes  Json     @default("[\"text\"]")
  outputModes Json     @default("[\"text\"]")
  askid       Int?
  apps        Json     @default("[]")
  level       String?
  price       Int      @default(0)
  priceModel  String?  @map("price_model")
  source      String?
  path        String?
  isPublic    Boolean  @default(true) @map("public")
  rentable    Boolean  @default(false)
  status      String   @default("active")
  version     String?

  // Marketplace aggregates (denormalized for fast listing).
  rating        Float    @default(0)
  ratingCount   Int      @default(0) @map("rating_count")
  installCount  Int      @default(0) @map("install_count")
  // Lowercased concatenation of name + description for substring contains search.
  // Kept server-side to avoid ILIKE spam on every query.
  searchableText String? @map("searchable_text")
  publishedAt   DateTime? @map("published_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  agentRels     AgentSkillRel[]
  toolRels      AgentSkillToolRel[]
  knowledgeRels  AgentSkillKnowledgeRel[]
  taskSkillRels  AgentTaskSkillRel[]
  ratings       SkillRating[]

  @@index([owner])
  @@index([name])
  @@index([category])
  @@index([isPublic])
  @@index([rating])
  @@index([installCount])
  @@index([isPublic, rating])
  @@index([isPublic, installCount])
  @@index([isPublic, category])
  @@map("agent_skills")
}

model AgentTask {
  id            String   @id @default(cuid())
  owner         String
  name          String
  description   String?
  status        String   @default("pending")
  priority      String   @default("normal")
  taskType      String?  @map("task_type")
  triggerType   String?  @map("trigger_type")
  action        String?
  duration      Int?
  orgId         String?  @map("org_id")
  objectives    Json     @default("[]")
  result        Json     @default("{}")
  schedule      Json     @default("{}")
  errorMessage  String?  @map("error_message")
  metadata      Json     @default("{}")
  source       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  agentRels      AgentTaskRel[]
  taskSkillRels  AgentTaskSkillRel[]

  @@index([owner])
  @@index([status])
  @@index([priority])
  @@map("agent_tasks")
}

model Vehicle {
  id                  String    @id @default(cuid())
  owner               String
  name                String
  description         String?
  vehicleType         String?   @map("vehicle_type")
  platform            String?
  architecture        String?
  environment         String?
  status              String    @default("offline")
  url                 String?
  hostname            String?
  ipAddress           String?   @map("ip_address")
  port                Int?
  accessToken         String?   @map("access_token")
  sslEnabled          Boolean   @default(false) @map("ssl_enabled")
  securityLevel       String?   @map("security_level")
  location            String?
  timezone            String?
  capabilities        Json      @default("{}")
  limitations         Json      @default("{}")
  settings            Json      @default("{}")
  extraMetadata       Json      @default("{}") @map("extra_metadata")
  gpuInfo             Json      @default("{}") @map("gpu_info")
  cpuCores            Int?      @map("cpu_cores")
  memoryGb            Float?    @map("memory_gb")
  storageGb           Float?    @map("storage_gb")
  maxConcurrentTasks  Int?      @map("max_concurrent_tasks")
  healthScore         Float?    @map("health_score")
  uptimeSeconds       BigInt?   @map("uptime_seconds")
  lastHeartbeat       DateTime? @map("last_heartbeat")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([owner])
  @@index([status])
  @@map("vehicles")
}

model Org {
  id          String   @id @default(cuid())
  name        String
  description String?
  orgType     String?  @map("org_type")
  parentId    String?  @map("parent_id")
  level       Int      @default(0)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  agents AgentOrgRel[]

  @@index([parentId])
  @@index([level])
  @@map("orgs")
}

model Prompt {
  id        String   @id @default(cuid())
  owner     String
  prompt    Json
  version   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([owner])
  @@map("prompts")
}

model Avatar {
  id              String    @id @default(cuid())
  owner           String?
  name            String?
  description     String?
  resourceType    String    @map("resource_type")
  imagePath       String?   @map("image_path")
  videoPath       String?   @map("video_path")
  imageHash       String?   @map("image_hash")
  videoHash       String?   @map("video_hash")
  cloudImageKey   String?   @map("cloud_image_key")
  cloudVideoKey   String?   @map("cloud_video_key")
  cloudImageUrl   String?   @map("cloud_image_url")
  cloudVideoUrl   String?   @map("cloud_video_url")
  cloudSynced     Boolean   @default(false) @map("cloud_synced")
  avatarMetadata  Json      @default("{}") @map("avatar_metadata")
  isPublic        Boolean   @default(false) @map("is_public")
  usageCount      Int       @default(0) @map("usage_count")
  lastUsedAt      DateTime? @map("last_used_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([owner])
  @@index([resourceType])
  @@map("avatars")
}

model AgentKnowledge {
  id            String   @id @default(cuid())
  owner         String
  name          String
  description   String?
  content       String?
  knowledgeType String?  @map("knowledge_type")
  categories    Json     @default("[]")
  tags          Json     @default("[]")
  accessMethods Json     @default("[]") @map("access_methods")
  limitations   Json     @default("[]")
  level         Int?
  price         Float    @default(0)
  priceModel    String?  @map("price_model")
  path          String?
  isPublic      Boolean  @default(false) @map("public")
  rentable      Boolean  @default(false)
  status        String   @default("active")
  settings      Json     @default("{}")
  config        Json     @default("{}")
  version       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  skillRels AgentSkillKnowledgeRel[]

  @@index([owner])
  @@index([name])
  @@index([knowledgeType])
  @@map("agent_knowledge")
}

model AgentTool {
  id           String   @id @default(cuid())
  owner        String
  name         String
  description  String?
  toolType     String?  @map("tool_type")
  capabilities Json     @default("[]")
  limitations  Json     @default("[]")
  dependencies Json     @default("[]")
  settings     Json     @default("{}")
  config       Json     @default("{}")
  level        Int?
  price        Float    @default(0)
  priceModel   String?  @map("price_model")
  path         String?
  isPublic     Boolean  @default(false) @map("public")
  rentable     Boolean  @default(false)
  status       String   @default("active")
  version      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  skillRels AgentSkillToolRel[]
  agentRels AgentToolRel[]

  @@index([owner])
  @@map("agent_tools")
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     Json
  owner     String   @default("__global__")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([owner])
  @@unique([owner, key])
  @@map("settings")
}

// ============ Relations ============

model AgentSkillRel {
  id                String    @id @default(cuid())
  agentId           String    @map("agent_id")
  skillId           String    @map("skill_id")
  proficiencyLevel  Int       @default(0) @map("proficiency_level")
  experiencePoints  Int       @default(0) @map("experience_points")
  certificationLevel Int      @default(0) @map("certification_level")
  usageCount        Int       @default(0) @map("usage_count")
  successRate       Float     @default(0) @map("success_rate")
  lastUsed          DateTime? @map("last_used")
  status            String    @default("active")
  isFavorite        Boolean   @default(false) @map("is_favorite")
  priority          Int       @default(0)
  config            Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
  @@map("agent_skill_rels")
}

model AgentTaskRel {
  id              String    @id @default(cuid())
  agentId         String    @map("agent_id")
  taskId          String    @map("task_id")
  vehicleId       String?   @map("vehicle_id")
  status          String    @default("assigned")
  priority        Int       @default(0)
  progress        Float     @default(0)
  scheduledStart  DateTime? @map("scheduled_start")
  actualStart     DateTime? @map("actual_start")
  estimatedEnd    DateTime? @map("estimated_end")
  actualEnd       DateTime? @map("actual_end")
  result          Json      @default("{}")
  errorMessage    String?   @map("error_message")
  logs            String?
  cpuUsage        Float?    @map("cpu_usage")
  memoryUsage     Float?    @map("memory_usage")
  executionTime   Float?    @map("execution_time")
  executionContext Json     @default("{}") @map("execution_context")
  retryCount      Int       @default(0) @map("retry_count")
  maxRetries      Int       @default(3) @map("max_retries")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([agentId, taskId])
  @@index([agentId])
  @@index([taskId])
  @@map("agent_task_rels")
}

model AgentToolRel {
  id        String   @id @default(cuid())
  agentId   String   @map("agent_id")
  toolId    String   @map("tool_id")
  permission String?
  grantedAt DateTime? @map("granted_at")
  status    String   @default("active")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  AgentTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
  @@map("agent_tool_rels")
}

model AgentOrgRel {
  id           String    @id @default(cuid())
  agentId      String    @map("agent_id")
  orgId        String    @map("org_id")
  role         String?
  accessLevel  String    @default("member") @map("access_level")
  status       String    @default("active")
  permissions  Json      @default("[]")
  joinDate     DateTime? @map("join_date")
  leaveDate    DateTime? @map("leave_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([agentId, orgId])
  @@index([agentId])
  @@index([orgId])
  @@map("agent_org_rels")
}

model AgentSkillToolRel {
  id               String    @id @default(cuid())
  skillId          String    @map("skill_id")
  toolId           String    @map("tool_id")
  dependencyType   String?   @map("dependency_type")
  usageFrequency   Int       @default(0) @map("usage_frequency")
  importance       Int       @default(0)
  toolConfig       Json      @default("{}") @map("tool_config")
  parameters       Json      @default("{}")
  usageCount       Int       @default(0) @map("usage_count")
  successRate      Float     @default(0) @map("success_rate")
  lastUsed         DateTime? @map("last_used")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  skill AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool  AgentTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolId])
  @@index([skillId])
  @@index([toolId])
  @@map("agent_skill_tool_rels")
}

model AgentSkillKnowledgeRel {
  id                String    @id @default(cuid())
  skillId           String    @map("skill_id")
  knowledgeId       String    @map("knowledge_id")
  dependencyType    String?   @map("dependency_type")
  usageFrequency    Int       @default(0) @map("usage_frequency")
  importance        Int       @default(0)
  accessPattern     String?   @map("access_pattern")
  knowledgeScope    Json      @default("{}") @map("knowledge_scope")
  accessCount       Int       @default(0) @map("access_count")
  lastAccessed      DateTime? @map("last_accessed")
  averageQueryTime  Float?    @map("average_query_time")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  skill     AgentSkill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  knowledge AgentKnowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([skillId, knowledgeId])
  @@index([skillId])
  @@index([knowledgeId])
  @@map("agent_skill_knowledge_rels")
}

model AgentTaskSkillRel {
  id                    String    @id @default(cuid())
  taskId               String    @map("task_id")
  skillId              String    @map("skill_id")
  role                 String?
  executionOrder        Int       @default(0) @map("execution_order")
  isRequired           Boolean   @default(true) @map("is_required")
  skillConfig          Json      @default("{}") @map("skill_config")
  parameters           Json      @default("{}")
  constraints          Json      @default("{}") @map("constraints_json")
  estimatedDuration    Float?    @map("estimated_duration")
  estimatedCost        Float?    @map("estimated_cost")
  resourceRequirements Json      @default("{}") @map("resource_requirements")
  successCriteria      Json      @default("{}") @map("success_criteria")
  qualityThreshold     Float?    @map("quality_threshold")
  status               String    @default("pending")
  actualDuration       Float?    @map("actual_duration")
  actualCost           Float?    @map("actual_cost")
  qualityScore         Float?    @map("quality_score")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  task  AgentTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([taskId, skillId])
  @@index([taskId])
  @@index([skillId])
  @@map("agent_task_skill_rels")
}

// ============ Skill Editor Events ============

model SkillEditorEvent {
  eventId    String   @id @default(cuid())
  owner      String
  sessionId  String   @map("session_id")
  flowgramId String?  @map("flowgram_id")
  eventType  String   @map("event_type")
  payload    Json     @default("{}")
  timestamp  DateTime @default(now())

  @@index([sessionId])
  @@index([owner, sessionId])
  @@index([owner])
  @@index([flowgramId])
  @@index([timestamp(sort: Desc)])
  @@map("skill_editor_events")
}

model WorkerLaunchRequest {
  requestId String   @id @map("request_id")
  ownerId   String   @map("owner_id")
  taskId    String   @map("task_id")
  status    String
  runId     String?  @map("run_id")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId, taskId])
  @@map("worker_launch_requests")
}

model CloudTaskRun {
  ownerId   String   @map("owner_id")
  taskId    String   @map("task_id")
  runId     String   @map("run_id")
  schedule  String   @default("")
  metaData  Json     @default("{}") @map("meta_data")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([ownerId, taskId])
  @@map("cloud_task_runs")
}

model CloudTaskRunHistory {
  id        BigInt   @id @default(autoincrement())
  ownerId   String   @map("owner_id")
  taskId    String   @map("task_id")
  runId     String   @map("run_id")
  schedule  String   @default("")
  metaData  Json     @default("{}") @map("meta_data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId, taskId, createdAt(sort: Desc)])
  @@map("cloud_task_run_history")
}

model AgentEndpoint {
  id              String   @id
  owner           String
  machineId       String   @map("machine_id")
  org             String
  name            String?
  role            String?
  skills          String?
  skillsHash      String?  @map("skills_hash")
  a2aRelayChannel String   @map("a2a_relay_channel")
  lanHint         String?  @map("lan_hint")
  ecanVer         String?  @map("ecan_ver")
  os              String?
  lastSeen        BigInt   @map("last_seen")
  ttl             Int      @default(180)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([owner, org])
  @@index([org, lastSeen])
  @@map("agent_endpoints")
}

model A2AMessage {
  id          String   @id @default(cuid())
  owner       String
  toAgentId   String   @map("to_agent_id")
  fromAgentId String   @map("from_agent_id")
  org         String
  payload     Json
  timestamp   DateTime @default(now())

  @@index([owner, toAgentId, timestamp(sort: Desc)])
  @@map("a2a_messages")
}

model RagDocument {
  id         String   @id @default(cuid())
  owner      String
  fid        String
  pid        String
  file       String
  type       String
  format     String
  options    Json
  version    String
  objectKey  String   @map("object_key")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([owner, pid, fid])
  @@index([owner, pid])
  @@map("rag_documents")
}

model LongLlmTask {
  id         String   @id @default(cuid())
  owner      String
  acctSiteId String?  @map("acct_site_id")
  agentId    String?  @map("agent_id")
  workType   String?  @map("work_type")
  taskId     String?  @map("task_id")
  status     String   @default("pending")
  input      Json     @default("{}")
  results    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([owner, status])
  @@map("long_llm_tasks")
}

model SkillEditorChatSession {
  id         String   @id @default(cuid())
  owner      String
  name       String
  flowgramId String?  @map("flowgram_id")
  state      String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  messages   SkillEditorChatMessage[]

  @@index([owner, updatedAt(sort: Desc)])
  @@map("skill_editor_chat_sessions")
}

model SkillEditorChatMessage {
  id          String   @id @default(cuid())
  owner       String
  sessionId   String   @map("session_id")
  role        String
  content     String
  attachments Json     @default("[]")
  metadata    Json     @default("{}")
  timestamp   DateTime @default(now())
  session     SkillEditorChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([owner, sessionId, timestamp])
  @@map("skill_editor_chat_messages")
}

// Agent runtime chat. queryChats records user/agent messages and returns
// the matched agent reply. The "agent reply" is the most recent assistant
// message in the same session whose content references the user's, plus
// any knowledge/doc IDs anchored to the same goal/topic; the production
// pipeline at the intl side calls an LLM here. For CN we keep storage
// verbatim so the surrounding UI is wired and tests round-trip cleanly.
model AgentChatMessage {
  id        String   @id @default(cuid())
  owner     String
  sessionId String   @map("session_id")
  role      String // "user" | "assistant" | "system"
  content   String
  goals     String?  // free-text goal/background the user supplied
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([owner, sessionId, createdAt])
  @@map("agent_chat_messages")
}

model LegacyRecord {
  id         String   @id @default(cuid())
  owner      String
  kind       String
  externalId String   @map("external_id")
  data       Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([owner, kind, externalId])
  @@index([owner, kind])
  @@map("legacy_records")
}

// Editor cache: per-user temporary state for the skill editor (recent files, unsaved buffers).
// Previously stored as LegacyRecord(kind='editor_cache'); migrated to a typed model.
model EditorCache {
  id           String   @id @default(cuid())
  owner        String
  cacheKey     String   @unique @map("cache_key")
  cacheData    Json     @default("{}") @map("cache_data")
  recentFiles  Json     @default("[]") @map("recent_files")
  version      String   @default("1.0")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([owner])
  @@map("editor_caches")
}

// Skill breakpoints: per-(username, node_name) toggle stored by the skill editor debugger.
// Previously stored as LegacyRecord(kind='skill_breakpoints'); migrated to a typed model.
model SkillBreakpoint {
  id        String   @id @default(cuid())
  owner     String
  username  String
  nodeName  String   @map("node_name")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([owner, username, nodeName])
  @@index([owner])
  @@map("skill_breakpoints")
}

// Skill run state: snapshot of skill execution injected by the editor for debugging.
// Previously stored as LegacyRecord(kind='skill_state'); migrated to a typed model.
model SkillRunState {
  id        String   @id @default(cuid())
  owner     String
  username  String
  skillKey  String   @map("skill_key")
  skill     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([owner, username, skillKey])
  @@index([owner, username])
  @@map("skill_run_states")
}

// Skill ratings: one row per (user, skill). score is 1-5. comment is optional
// and limited at the resolver layer. Aggregates (rating, ratingCount) are
// denormalized on AgentSkill so listings can sort without an aggregate scan.
model SkillRating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skill     AgentSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
  @@index([skillId, score])
  @@map("skill_ratings")
}

// Skill install / borrowing records. installCount on AgentSkill mirrors the
// row count here. We keep the user-visible row so we can answer "do I have
// this skill installed?" without scanning the agent_skill_rels table.
model SkillInstall {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  agentId   String?  @map("agent_id")
  status    String   @default("installed")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, skillId])
  @@index([skillId])
  @@index([userId])
  @@map("skill_installs")
}

// Skill purchase / rental orders. priceCents is the snapshot at purchase
// time; the catalog `price` may change but the order keeps what was paid.
model SkillOrder {
  id         String   @id @default(cuid())
  buyerId    String   @map("buyer_id")
  sellerId   String   @map("seller_id")
  skillId    String   @map("skill_id")
  priceCents Int      @map("price_cents")
  priceModel String?  @map("price_model")
  status     String   @default("pending") // pending | paid | refunded | failed
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([sellerId])
  @@index([skillId])
  @@index([status])
  @@map("skill_orders")
}

// Account notifications: account-scoped events surfaced to the user via subscriptions.
// Previously stored as LegacyRecord(kind='notification'); migrated to a typed model.
model AccountNotification {
  id        String   @id @default(cuid())
  owner     String
  notifId   String   @unique @map("notif_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([owner, createdAt(sort: Desc)])
  @@map("account_notifications")
}

model WanMessage {
  id         String   @id @default(cuid())
  owner      String
  chatId     String?  @map("chat_id")
  sender     String?
  receiver   String?
  type       String?
  contents   String?
  parameters String?
  timestamp  DateTime @default(now())

  @@index([owner, chatId, timestamp(sort: Desc)])
  @@map("wan_messages")
}

model ApiCredential {
  id        String   @id @default(cuid())
  owner     String
  keyHash   String   @unique @map("key_hash")
  keyPrefix String   @map("key_prefix")
  label     String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([owner, status])
  @@map("api_credentials")
}

// WeChat silent-refresh: stores a server-side refresh credential so that
// WeChat-logged-in users don't need to re-scan the QR code every 10 minutes.
//
// Flow:
//   1. First WeChat login: client → CloudBase wx_open → gets access_token
//   2. Client calls registerWeChatSession(openid, access_token) with the
//      current CloudBase JWT (extracts openid from it)
//   3. Backend mints a custom JWT (eCan refresh token, 30-day expiry) and
//      stores its hash in this table alongside the WeChat openid.
//   4. On token expiry: client calls refreshWeChatToken(sessionToken) with the
//      custom JWT. Backend re-verifies the openid via CloudBase /auth/v1/user/me
//      and returns a fresh CloudBase access_token.
//   5. Client stores the new access_token and keeps the session token alive.
//
// The custom JWT is opaque to the client — it only needs to store and replay it.
model WeChatSession {
  id            String    @id @default(cuid())
  openid        String    @unique @map("openid")
  sessionToken  String    @map("session_token")  // bcrypt hash of custom JWT
  wxAccessToken String?   @map("wx_access_token") // current CloudBase JWT (encrypted)
  owner         String                               // CloudBase user sub
  expiresAt     DateTime  @map("expires_at")        // custom JWT expiry
  lastRefreshed DateTime @default(now()) @map("last_refreshed")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([owner])
  @@index([expiresAt])
  @@map("wechat_sessions")
}
