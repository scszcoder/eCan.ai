# ============================================================
# eCan.ai CN 版本 - TCB 云函数配置
# ============================================================
# 本地开发配置（仅用于本地测试，需要 PostgreSQL 公网访问）
# 生产环境使用云函数环境变量

# ============ PostgreSQL 连接信息 ============
# 从 TCB 云数据库 PostgreSQL 实例详情页获取

# 数据库主机地址（内网地址）
PG_HOST=10.16.x.x

# 数据库端口
PG_PORT=5432

# 数据库名称
PG_DATABASE=postgres

# 数据库用户名
PG_USER=postgres

# 数据库密码
PG_PASSWORD=your_password_here

# ============ TCB 环境信息 ============
# 从 CloudBase 控制台获取

# TCB 环境 ID
TCB_ENV_ID=your-env-id

# TCB API 地址（云函数部署后）
TCB_API_URL=https://your-env.service.tcloudbase.com/api/graphql

# ============ 本地开发配置 ============

# Node 环境
NODE_ENV=development

# 本地服务器端口（仅本地测试用）
LOCAL_PORT=3000

# 是否启用调试日志
DEBUG=true
