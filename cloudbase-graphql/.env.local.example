# ============================================================
# eCan.ai CN 版本 - TCB 云函数配置
# ============================================================
# 使用云数据库 PostgreSQL (TDSQL-C)

# ============ PostgreSQL 连接信息 =============
# 从 TCB 云数据库 PostgreSQL 实例详情页获取
# 格式: postgresql://user:password@host:5432/database

DATABASE_URL=postgresql://username:password@10.16.x.x:5432/ecan

# ============ TCB 环境信息 ============
# 从 CloudBase 控制台获取

# TCB 环境 ID
TCB_ENV_ID=your-env-id

# TCB API 地址（云函数部署后）
TCB_API_URL=https://your-env.service.tcloudbase.com/api/graphql

# ============ COS 用户文件存储 ============
# Bucket 必须是完整名称：bucket-name-APPID
COS_BUCKET=ecan-cn-files-1250000000
COS_REGION=ap-guangzhou

# 本地开发可填写长期密钥；生产环境应使用 SCF 绑定的最小权限 CAM 角色。
# ECAN_TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxx
# ECAN_TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ============ CN 云任务调度 ============
# 承载本 GraphQL handler 的 SCF 函数名，定时触发器会绑定到该函数。
TENCENT_SCHEDULER_FUNCTION=ecan-graphql-api
TENCENT_SCF_NAMESPACE=default
TENCENT_REGION=ap-guangzhou

# TKE 内网 CLB 地址及共享 HMAC 密钥（SCF 所在 VPC 必须可达）。
TENCENT_WORKER_LAUNCH_URL=http://10.0.0.10/jobs
# TENCENT_WORKER_LAUNCH_SECRET=replace-with-a-long-random-secret

# 独立 WebSocket SCF 的内部 push/status 接口密钥。
# WEBSOCKET_PUSH_SECRET=replace-with-another-long-random-secret

# ============ 本地开发配置 ============

# Node 环境
NODE_ENV=development

# 本地服务器端口（仅本地测试用）
LOCAL_PORT=3000

# 是否启用调试日志
DEBUG=true

# 仅限本地开发。生产环境严禁启用；启用后可通过 X-ECAN-Test-User 模拟用户。
ALLOW_INSECURE_AUTH=false
