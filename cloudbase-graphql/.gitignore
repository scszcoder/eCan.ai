.deploy_versions.json

# TCS deploy runtime artifacts (generated by deploy-ws-tcs.sh at deploy time)
# - .tcb-vpc-config.json: --vpc-config payload, written to avoid TTY word-splitting
# - scripts/_tcs_deploy.exp: expect script that drives the TCB CLI through prompts
# - cloudbaserc.json: written by `tcb cloudrun deploy --source ./ws` to scope
#   the cloud build to that subdir. CSB never reads this file (TCB does).
.tcb-vpc-config.json
scripts/_tcs_deploy.exp
cloudbaserc.json
