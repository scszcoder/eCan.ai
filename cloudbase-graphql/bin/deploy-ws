#!/bin/bash
# ============================================================
# eCan.ai WS 服务 — 一行命令全自动化部署 (--source 模式)
# ============================================================
#
# 用法:
#   ./bin/deploy-ws                  # TCB 云端构建 + 部署 + 同步 (默认)
#   ./bin/deploy-ws --dry-run        # 仅打印步骤, 不实际操作
#
# 前置条件 (一次性):
#   1. tcb login                              (CAM 凭证已在本机)
#   2. .env.local 中 TCB_ENV_ID 已配置
#
# 不需要 docker login TCR: --source 模式让 TCB 云端构建镜像.
# 镜像不含 WS_PUSH_SECRET 等明文密钥 (通过源码占位符 + trap 注入和还原).
#
# 自动化步骤:
#   1. 加载 .env.local
#   2. 验证前置条件 (tcb)
#   3. 调用 deploy-ws-tcs.sh --source (TCB 云端构建 + 部署 + 关闭老版本)
#   4. 抓取 WS_TCS_URL 写入 .env.local
#   5. 同步 WS_TCS_URL + WS_PUSH_SECRET 到 SCF
#   6. 健康检查 (失败则提示 rollback)
#   7. 输出最终状态

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DEPLOY_SCRIPT="$PROJECT_DIR/deploy-ws-tcs.sh"
HEALTH_TIMEOUT=120   # 健康检查最多等 120 秒
HEALTH_INTERVAL=5    # 每 5 秒检查一次

DRY_RUN=false
for arg in "$@"; do
  case $arg in
    --dry-run)    DRY_RUN=true ;;
    --help|-h)
      echo "用法: $0 [OPTIONS]"
      echo "  --dry-run      仅打印步骤, 不操作"
      exit 0
      ;;
    -*)            echo -e "${RED}Unknown option: $arg${NC}" >&2; exit 1 ;;
  esac
done

cd "$PROJECT_DIR"

# ============ 步骤 1: 加载 .env.local ============
echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}  eCan.ai WS 服务 — 一键部署${NC}"
echo -e "${BLUE}========================================${NC}"

if [ ! -f ".env.local" ]; then
  echo -e "${RED}❌ .env.local 不存在${NC}"; exit 1
fi
set -a; . .env.local; set +a

TCB_ENV_ID="${TCB_ENV_ID:-sccb0-d0gc5398xf028be6a}"
TCR_NAMESPACE="${TCR_NAMESPACE:-$(echo $TCB_ENV_ID | cut -d'-' -f1)}"
TCR_IMAGE_TAG="ccr.ccs.tencentyun.com/${TCR_NAMESPACE}/ecan-graphql-ws:latest"

echo -e "  环境:    $TCB_ENV_ID"
echo -e "  TCR NS:  $TCR_NAMESPACE"
echo -e "  镜像:    $TCR_IMAGE_TAG"

# ============ 步骤 2: 验证前置条件 ============
echo ""
echo -e "${YELLOW}🔍 验证前置条件...${NC}"

# tcb (唯一的前置条件, --source 模式不需要 docker)
if ! command -v tcb >/dev/null 2>&1; then
  echo -e "${RED}  ❌ tcb CLI 未安装 (npm i -g @cloudbase/cli)${NC}"; exit 1
fi
echo -e "  ${GREEN}✓${NC} tcb"

if $DRY_RUN; then
  echo -e "\n${YELLOW}🔍 DRY RUN — 不会执行任何操作${NC}"
  exit 0
fi

START_TIME=$(date +%s)

# ============ 步骤 3: 部署 (--source 模式, TCB 云端构建) ============
# 注意: 本脚本**仅支持 --source 模式**。本地 docker build/push 已废弃:
#   secrets 通过 Dockerfile ARG → ENV 永久写入 image layer, pull 镜像就能看到明文密钥。
#   --source 模式用 TCB 云端构建, 源码占位符注入 + trap 还原, 密钥不进入镜像也不留在源码。
echo ""
echo -e "${YELLOW}🚀 TCB 云端构建 + 部署...${NC}"
"$DEPLOY_SCRIPT" --source

# ============ 步骤 4: 自动抓 WS_TCS_URL ============
echo ""
echo -e "${YELLOW}🔗 获取 WS 服务内网访问地址...${NC}"

WS_TCS_URL=$(tcb cloudrun detail --service-name ecan-graphql-ws --json 2>/dev/null | node -e "
let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
  try{
    // TCB detail API wraps the body in { data: { ... } } or returns the
    // inner object directly depending on the CLI version. Handle both.
    const j=JSON.parse(d);
    const inner = j.data || j;
    const versions = inner.OnlineVersionInfos || [];
    const v = versions[versions.length-1];
    // 优先取内网 IP, 否则取外网访问地址 (DefaultDomainName 在 BaseInfo)
    const url = v?.ClusterInternalAccessHost || v?.AccessAddress || v?.Endpoint || '';
    const port = inner.ServerConfig?.Port || 9102;
    console.log(url ? ('http://'+url+':'+port) : '');
  }catch(e){console.log('')}
})
" 2>/dev/null || echo "")

if [ -z "$WS_TCS_URL" ]; then
  echo -e "  ${YELLOW}⚠️  无法自动获取 WS_TCS_URL, 请在 TCB 控制台查找并手动配置${NC}"
else
  echo -e "  ${GREEN}✓${NC} WS_TCS_URL=$WS_TCS_URL"

  # 写回 .env.local
  if grep -q "^WS_TCS_URL=" .env.local; then
    sed -i.bak "s|^WS_TCS_URL=.*|WS_TCS_URL=$WS_TCS_URL|" .env.local && rm -f .env.local.bak
  else
    echo "WS_TCS_URL=$WS_TCS_URL" >> .env.local
  fi
  echo -e "  ${GREEN}✓${NC} 已写入 .env.local"
fi

# ============ 步骤 8: 同步到 SCF ============
echo ""
echo -e "${YELLOW}🔄 同步环境变量到 SCF...${NC}"
if [ -x "./bin/sync-tcb-env" ]; then
  ./bin/sync-tcb-env 2>&1 | tail -10 \
    && echo -e "  ${GREEN}✓${NC} SCF 环境变量已同步" \
    || echo -e "  ${YELLOW}⚠️  SCF 同步失败, 可手动运行 ./bin/sync-tcb-env${NC}"
else
  echo -e "  ${YELLOW}⚠️  ./bin/sync-tcb-env 不存在或无执行权限${NC}"
fi

# ============ 步骤 9: 健康检查 ============
if [ -n "$WS_TCS_URL" ]; then
  echo ""
  echo -e "${YELLOW}🏥 健康检查 (最多 ${HEALTH_TIMEOUT}s)...${NC}"
  ELAPSED=0
  HEALTHY=false
  while [ $ELAPSED -lt $HEALTH_TIMEOUT ]; do
    if curl -sf -m 5 "$WS_TCS_URL/healthz" >/dev/null 2>&1; then
      HEALTHY=true
      break
    fi
    sleep $HEALTH_INTERVAL
    ELAPSED=$((ELAPSED + HEALTH_INTERVAL))
    echo -n "."
  done
  echo ""

  if $HEALTHY; then
    echo -e "  ${GREEN}✓ 健康检查通过 ($WS_TCS_URL/healthz)${NC}"
  else
    echo -e "  ${RED}❌ 健康检查失败 ($WS_TCS_URL/healthz)${NC}"
    echo -e "  ${YELLOW}⚠️  建议手动 rollback: tcb cloudrun version rollback --service-name ecan-graphql-ws${NC}"
    exit 1
  fi
fi

# ============ 步骤 10: 最终报告 ============
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
MIN=$((DURATION / 60))
SEC=$((DURATION % 60))

echo ""
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}  ✅ WS 服务部署完成 (用时 ${MIN}m${SEC}s)${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""
echo -e "  ${BLUE}WSS 端点 (客户端用):${NC}"
# WS 服务默认公网域名 (由 tcb cloudrun 分配, 不可配自定义域名)
WS_DOMAIN=$(tcb cloudrun detail --service-name ecan-graphql-ws --json 2>/dev/null | node -e "
let d=''; process.stdin.on('data',c=>d+=c).on('end',()=>{
  try{
    const j=JSON.parse(d);
    const inner = j.data || j;
    console.log(inner.BaseInfo?.DefaultDomainName || '');
  }catch(e){console.log('')}
})" 2>/dev/null || echo "")
echo -e "    ${WS_DOMAIN}/?token=\${JWT}  (graphql-ws subprotocol)"
echo ""
echo -e "  ${BLUE}内网推送地址 (SCF → WS 服务, 不对外暴露):${NC}"
echo -e "    $WS_TCS_URL"
echo ""
echo -e "  ${BLUE}健康检查:${NC}"
echo -e "    curl $WS_TCS_URL/healthz"
echo ""
echo -e "  ${BLUE}查看日志:${NC}"
echo -e "    tcb cloudrun logs --service-name ecan-graphql-ws logs process"
echo ""
