{
  "family": "ecan-cloud-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "ecan-cloud-worker",
      "image": "${ECR_IMAGE_URI}",
      "command": [
        "python",
        "-m",
        "agent.cloud_worker.worker_main"
      ],
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "DISPLAY",
          "value": ":99"
        },
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "GEMINI_API_KEY",
          "value": ""
        },
        {
          "name": "DEEPSEEK_API_KEY",
          "value": ""
        },
        {
          "name": "DASHSCOPE_API_KEY",
          "value": ""
        },
        {
          "name": "KIMI_API_KEY",
          "value": ""
        },
        {
          "name": "S3_BUCKET",
          "value": "${S3_BUCKET}"
        },
        {
          "name": "ECAN_SKILLS_BUCKET",
          "value": "${S3_BUCKET}"
        },
        {
          "name": "S3_KEY_ROOT",
          "value": "${S3_KEY_ROOT}"
        },
        {
          "name": "ECAN_USER_BASE_PREFIX",
          "value": "${S3_KEY_ROOT}"
        },
        {
          "name": "SQS_QUEUE_URL",
          "value": "${SQS_QUEUE_URL}"
        },
        {
          "name": "ECAN_SQS_QUEUE_URL",
          "value": "${SQS_QUEUE_URL}"
        },
        {
          "name": "APPSYNC_API_URL",
          "value": "${APPSYNC_API_URL}"
        },
        {
          "name": "APPSYNC_API_KEY",
          "value": "${APPSYNC_API_KEY}"
        }
      ],
      "secrets": [
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "${OPENAI_SECRET_ARN}:api_key::"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "valueFrom": "${ANTHROPIC_SECRET_ARN}:api_key::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecan-cloud-worker",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "pgrep -f 'python|Xvfb' || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "linuxParameters": {
        "initProcessEnabled": true,
        "sharedMemorySize": 2048
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ]
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "eCan.ai"
    },
    {
      "key": "Component",
      "value": "cloud-worker"
    }
  ]
}
