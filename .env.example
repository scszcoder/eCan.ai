# ============================================================
# eCan.ai 环境变量配置 - 团队模板
# ============================================================
# 此文件是 .env 的模板，包含了所有可能的环境变量
# 复制为 .env 后填入实际值
#
# 使用方式:
#   cp .env.example .env
#   # 编辑 .env 填入实际值
#
# 重要: .env 已在 .gitignore 中，不会被提交到 git
# ============================================================

# ============================================================
# SECTION 1: 产品配置 (必须)
# ============================================================

# 产品标识 - 区分 CN 和 Intl 版本
# 可选值: cn | intl
# CN 版本使用腾讯云 CloudBase 认证
# Intl 版本使用 AWS Cognito 认证
ECAN_APP_ID=intl

# ============================================================
# SECTION 2: 日志配置 (可选，有默认值)
# ============================================================

# 日志级别
# 可选值: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 调试模式 (布尔值)
# 启用后会在短信发送响应中返回验证码（仅供本地测试）
DEBUG_MODE=false

# ============================================================
# SECTION 3: 云服务凭证 (按需配置)
# ============================================================
# 提示: 这些是敏感信息，请勿提交到 git
# ============================================================

# ---- AWS 凭证 (Intl 版本) ----
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ---- 腾讯云凭证 (CN 版本，必须) ----
# ECAN_TENCENT_SECRET_ID=your_tencent_secret_id
# ECAN_TENCENT_SECRET_KEY=your_tencent_secret_key
# ECAN_TENCENT_REGION=ap-guangzhou

# ---- CloudBase 环境 (CN 版本，必须) ----
# 在腾讯云 CloudBase 控制台创建环境后获取
# ECAN_TENCENT_CLOUDBASE_ENV_ID=ecan-cn-prod-xxxx

# ---- JWT 配置 (CN 版本，强烈建议生产环境配置) ----
# 用于生成应用内部 Token，至少 32 个字符
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ECAN_JWT_SECRET=your-jwt-secret-at-least-32-chars-long
# ECAN_JWT_EXPIRES_IN=86400

# ---- 短信服务 (CN 版本，手机号登录需要) ----
# 在腾讯云短信服务 https://console.cloud.tencent.com/smsv2 创建应用
# ECAN_TENCENT_SMS_SDK_APP_ID=1400000000
# ECAN_TENCENT_SMS_TEMPLATE_ID=123456
# ECAN_TENCENT_SMS_SIGN_NAME=eCan

# ---- 登录方式开关 (CN 版本，可选) ----
# ECAN_ENABLE_EMAIL_LOGIN=true
# ECAN_ENABLE_PHONE_LOGIN=true
# ECAN_ENABLE_SIGNUP=true

# ---- LLM API Keys ----
# OpenAI
# OPENAI_API_KEY=sk-xxxx

# Claude (Anthropic)
# CLAUDE_API_KEY=sk-ant-xxxx

# Gemini (Google)
# GEMINI_API_KEY=AIza...

# DashScope (阿里云)
# DASHSCOPE_API_KEY=sk-xxxx

# ============================================================
# SECTION 4: WebSocket 配置 (高级)
# ============================================================
# 大多数情况下不需要手动配置，会自动从云端获取

# AppSync WebSocket 端点 (Intl)
# ECAN_WS_URL=wss://xxxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql

# ============================================================
# SECTION 5: 构建配置 (CI/CD 自动设置)
# ============================================================

# 构建目标平台
# 可选值: desktop | web
# ECAN_MODE=desktop

# 构建目标架构 (Linux)
# 可选值: x64 | arm64
# TARGET_ARCH=x64
