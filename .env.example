# ============================================================
# eCan.ai 环境变量模板
# ============================================================
# 用法:
#   cp .env.example .env   # 复制为本地配置
#   $EDITOR .env           # 填入实际值
#
# .env 已在 .gitignore 中，不会被提交。
# 下面所有未注释（无前导 #）的 KEY=VALUE 行就是"应填但目前没填"的占位，
# 注释掉的条目表示"按需启用"。
#
# 图例:
#   [MUST]      必须配置（CN/Intl 通用）
#   [CN]        CN 版本必填（腾讯云 / CloudBase 认证）
#   [Intl]      Intl 版本必填（AWS Cognito）
#   [OPT]       可选，不填走代码默认值
#   [BUILD]     CI/CD 注入，本地通常不需要
# ============================================================


# ------------------------------------------------------------
# 产品标识（必填）
# ------------------------------------------------------------
# 可选值: cn | intl
# CN 版本走腾讯云 CloudBase 认证；Intl 走 AWS Cognito
ECAN_APP_ID=cn


# ------------------------------------------------------------
# 腾讯云凭证（CN 版本可选，私密字段）
# ------------------------------------------------------------
# CloudBase Auth API (登录/注册/验证码) 使用 Bearer token 认证，不需要 secret_id/key
# 只有调用腾讯云其他服务（如自定义 SMS、云存储）时才需要
# 在 https://console.cloud.tencent.com/cam/capi 新建 API 密钥
# ECAN_TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxx
# ECAN_TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 可选（不填默认 ap-guangzhou）
# ECAN_TENCENT_REGION=ap-guangzhou


# ------------------------------------------------------------
# CloudBase 环境（CN 版本必填，公开字段从 auth_config.yml 读）
# ------------------------------------------------------------
# env_id 在腾讯云 CloudBase 控制台创建环境后可见
# 该值同时写到 apps/cn/config/auth_config.yml 的 CLOUDBASE.ENV_ID
# 后端通过 auth_config.yml 读取；下面这行是 GUI/前端 override（开发时方便切换环境）
# ECAN_TENCENT_CLOUDBASE_ENV_ID=ecan-cn-xxxxxxxx

# CloudBase GraphQL 云函数端点（CN 版本，部署 cloudbase-graphql 后填写）
# 格式: https://service-xxxx-xxxx.{env_id}.{region}.tcb-api.tencentcloudapi.com
# CLOUDBASE_GRAPHQL_ENDPOINT=https://service-xxxx-xxxx.sccb0-d0gc5398xf028be6a.ap-shanghai.tcb-api.tencentcloudapi.com/graphql
# CLOUDBASE_SSE_ENDPOINT=https://service-xxxx-xxxx.sccb0-d0gc5398xf028be6a.ap-shanghai.tcb-api.tencentcloudapi.com/sse/subscribe


# ------------------------------------------------------------
# 微信登录（CN 版本，按需）
# ------------------------------------------------------------
# AppID 填入 apps/cn/config/auth_config.yml 的 WECHAT.APP_ID
# AppSecret 仅需在 CloudBase 控制台配置，无需在此设置
# 前端运行时也需要 VITE_WECHAT_APP_ID（写在 apps/cn/config/auth_config.yml 的 WECHAT.APP_ID）


# ------------------------------------------------------------
# 短信服务（CN 版本可选）
# ------------------------------------------------------------
# CloudBase 内置 SMS（不需要单独配置腾讯云短信服务）
# 只有 CloudBase 内置 SMS 不可用时才需要配置自己的腾讯云短信
# 在 https://console.cloud.tencent.com/smsv2 创建应用后获取
# ECAN_TENCENT_SMS_SDK_APP_ID=1400000000
# ECAN_TENCENT_SMS_TEMPLATE_ID=123456
# ECAN_TENCENT_SMS_SIGN_NAME=eCan


# ------------------------------------------------------------
# AWS 凭证（Intl 版本必填，私密字段）
# ------------------------------------------------------------
# 用于 Cognito 认证。IAM 用户至少需要 AmazonCognitoPowerUser 权限
# AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1


# ------------------------------------------------------------
# 登录方式开关（CN 版本，可选，覆盖 yml 默认）
# ------------------------------------------------------------
# ECAN_ENABLE_EMAIL_LOGIN=true
# ECAN_ENABLE_PHONE_LOGIN=true
# ECAN_ENABLE_SIGNUP=true
# ECAN_ENABLE_WECHAT_LOGIN=true


# ------------------------------------------------------------
# LLM API Keys（按需启用，留空表示不使用对应 provider）
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxx
# CLAUDE_API_KEY=sk-ant-xxxx
# GEMINI_API_KEY=AIza...
# DASHSCOPE_API_KEY=sk-xxxx


# ------------------------------------------------------------
# 日志 / 调试（可选）
# ------------------------------------------------------------
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 调试模式。启用后 SMS 发送响应会返回验证码（仅本地测试用）
DEBUG_MODE=false


# ------------------------------------------------------------
# WebSocket / 网络（可选，自动从云端拉取，无需手填）
# ------------------------------------------------------------
# AppSync WebSocket (Intl)
# ECAN_WS_URL=wss://xxxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql
# 本地服务监听地址（默认 127.0.0.1）
# ECAN_LOCAL_SERVER_HOST=127.0.0.1
# ECAN_LOCAL_SERVER_PORT=8765


# ------------------------------------------------------------
# 构建配置（CI/CD 自动注入，本地通常不需要）
# ------------------------------------------------------------
# 桌面/Web 运行模式
# ECAN_MODE=desktop

# 打包目标架构 (Linux)
# TARGET_ARCH=x64

# 运行环境标识（影响部分日志/特性开关）
# ECAN_ENVIRONMENT=development
